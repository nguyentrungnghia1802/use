  self.orderEntries_R005->isUnique(rank) and self.orderEntries_R005->isUnique(value) and self.orderEntries_R005->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R005->size()) and self.orderEntries_R005->collect(value)->asSet() = self.subGroups->asSet()
context Mission inv order_R015:
  self.orderEntries_R015->isUnique(rank) and self.orderEntries_R015->isUnique(value) and self.orderEntries_R015->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R015->size()) and self.orderEntries_R015->collect(value)->asSet() = self.goals->asSet()
context OPlan inv order_R017:
  self.orderEntries_R017->isUnique(rank) and self.orderEntries_R017->isUnique(value) and self.orderEntries_R017->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R017->size()) and self.orderEntries_R017->collect(value)->asSet() = self.subGoals->asSet()
context Operation inv order_R037:
  self.orderEntries_R037->isUnique(rank) and self.orderEntries_R037->isUnique(value) and self.orderEntries_R037->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R037->size()) and self.orderEntries_R037->collect(value)->asSet() = self.properties->asSet()

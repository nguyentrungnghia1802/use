constraints
context Agent inv order_R023:
  self.orderEntries_R023->isUnique(rank) and self.orderEntries_R023->isUnique(value) and self.orderEntries_R023->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R023->size()) and self.orderEntries_R023->collect(value)->asSet() = self.artifacts->asSet()
context Agent inv order_R019:
  self.orderEntries_R019->isUnique(rank) and self.orderEntries_R019->isUnique(value) and self.orderEntries_R019->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R019->size()) and self.orderEntries_R019->collect(value)->asSet() = self.beliefs->asSet()
context Agent inv order_R020:
  self.orderEntries_R020->isUnique(rank) and self.orderEntries_R020->isUnique(value) and self.orderEntries_R020->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R020->size()) and self.orderEntries_R020->collect(value)->asSet() = self.goals->asSet()

model V2Ordered

enum ActionKind { INTERNAL, EXTERNAL }
enum AgentGoalType { ACHIEVEMENT, TEST }
enum GoalType { ACHIEVEMENT, MAINTENANCE }
enum LinkScope { INTRA_GROUP, INTER_GROUP }
enum LinkType { AUTHORITY, COMMUNICATION, ACQUAINTANCE }
enum NormType { OBLIGATION, PERMISSION }
enum OPlanOperator { SEQUENCE, PARALLEL, CHOICE }
class AGoal
attributes
  literal : String
  type : AgentGoalType
end

class Action
attributes
  arity : Integer
  kind : ActionKind
  name : String
end

class Agent
attributes
  name : String
  source : String
operations
  ordered_R023() : Sequence(Artifact) = self.orderEntries_R023->sortedBy(rank)->collect(value)->asSequence()
  ordered_R019() : Sequence(Belief) = self.orderEntries_R019->sortedBy(rank)->collect(value)->asSequence()
  ordered_R020() : Sequence(AGoal) = self.orderEntries_R020->sortedBy(rank)->collect(value)->asSequence()
  ordered_R018() : Sequence(Plan) = self.orderEntries_R018->sortedBy(rank)->collect(value)->asSequence()
  ordered_R021() : Sequence(Role) = self.orderEntries_R021->sortedBy(rank)->collect(value)->asSequence()
  ordered_R022() : Sequence(Workspace) = self.orderEntries_R022->sortedBy(rank)->collect(value)->asSequence()
end

class Artifact
attributes
  name : String
  type : String
operations
  ordered_R035() : Sequence(Agent) = self.orderEntries_R035->sortedBy(rank)->collect(value)->asSequence()
  ordered_R033() : Sequence(Operation) = self.orderEntries_R033->sortedBy(rank)->collect(value)->asSequence()
  ordered_R034() : Sequence(Property) = self.orderEntries_R034->sortedBy(rank)->collect(value)->asSequence()
end

class Belief
attributes
  literal : String
end

class Environment
operations
  ordered_R030() : Sequence(Workspace) = self.orderEntries_R030->sortedBy(rank)->collect(value)->asSequence()
end

class Event
attributes
  literal : String
  operator : String
  type : String
end

class Group
attributes
  id : String
  maxCardinality : String
  minCardinality : String
operations
  ordered_R006() : Sequence(Link) = self.orderEntries_R006->sortedBy(rank)->collect(value)->asSequence()
  ordered_R004() : Sequence(Role) = self.orderEntries_R004->sortedBy(rank)->collect(value)->asSequence()
  ordered_R005() : Sequence(Group) = self.orderEntries_R005->sortedBy(rank)->collect(value)->asSequence()
end

class Link
attributes
  bidirectional : Boolean
  extendsSubgroups : Boolean
  scope : LinkScope
  type : LinkType
end

class Mission
attributes
  id : String
  maxCardinality : String
  minCardinality : String
operations
  ordered_R015() : Sequence(OGoal) = self.orderEntries_R015->sortedBy(rank)->collect(value)->asSequence()
end

class Norm
attributes
  condition : String
  id : String
  timeConstraint : String
  type : NormType
end

class OGoal
attributes
  description : String
  id : String
  minAgentsToSatisfy : String
  timeToFulfill : String
  type : GoalType
end

class OPlan
attributes
  operator : OPlanOperator
operations
  ordered_R017() : Sequence(OGoal) = self.orderEntries_R017->sortedBy(rank)->collect(value)->asSequence()
end

class Operation
attributes
  arity : Integer
  name : String
operations
  ordered_R037() : Sequence(Property) = self.orderEntries_R037->sortedBy(rank)->collect(value)->asSequence()
  ordered_R036() : Sequence(Signal) = self.orderEntries_R036->sortedBy(rank)->collect(value)->asSequence()
end

class Organization
attributes
  id : String
operations
  ordered_R001() : Sequence(Group) = self.orderEntries_R001->sortedBy(rank)->collect(value)->asSequence()
  ordered_R003() : Sequence(Norm) = self.orderEntries_R003->sortedBy(rank)->collect(value)->asSequence()
  ordered_R002() : Sequence(Scheme) = self.orderEntries_R002->sortedBy(rank)->collect(value)->asSequence()
end

class Plan
attributes
  ecore_Plan_context : String
  label : String
operations
  ordered_R025() : Sequence(Action) = self.orderEntries_R025->sortedBy(rank)->collect(value)->asSequence()
end

class Property
attributes
  arity : Integer
  name : String
end

class Role
attributes
  id : String
  isAbstract : Boolean
  maxCardinality : String
  minCardinality : String
operations
  ordered_R008() : Sequence(Agent) = self.orderEntries_R008->sortedBy(rank)->collect(value)->asSequence()
  ordered_R007() : Sequence(Role) = self.orderEntries_R007->sortedBy(rank)->collect(value)->asSequence()
end

class Scheme
attributes
  id : String
operations
  ordered_R014() : Sequence(Mission) = self.orderEntries_R014->sortedBy(rank)->collect(value)->asSequence()
end

class Signal
attributes
  arity : Integer
  name : String
end

class Workspace
attributes
  name : String
operations
  ordered_R032() : Sequence(Agent) = self.orderEntries_R032->sortedBy(rank)->collect(value)->asSequence()
  ordered_R031() : Sequence(Artifact) = self.orderEntries_R031->sortedBy(rank)->collect(value)->asSequence()
end

association AGoal_organizationalGoal_OGoal between
  AGoal[*] role source_organizationalGoal
  OGoal[0..1] role organizationalGoal
end

association Action_operation_Operation between
  Action[*] role source_operation
  Operation[0..1] role operation
end

association Agent_artifacts_Artifact between
  Agent[*] role agents ordered
  Artifact[*] role artifacts ordered
end

composition Agent_beliefs_Belief between
  Agent[0..1] role source_beliefs
  Belief[*] role beliefs ordered
end

composition Agent_goals_AGoal between
  Agent[0..1] role source_goals
  AGoal[*] role goals ordered
end

composition Agent_plans_Plan between
  Agent[0..1] role source_plans
  Plan[*] role plans ordered
end

association Agent_roles_Role between
  Agent[*] role agents ordered
  Role[*] role roles ordered
end

association Agent_workspaces_Workspace between
  Agent[*] role agents ordered
  Workspace[*] role workspaces ordered
end

composition Artifact_operations_Operation between
  Artifact[0..1] role source_operations
  Operation[*] role ecore_Artifact_operations ordered
end

composition Artifact_properties_Property between
  Artifact[0..1] role source_Artifact_properties
  Property[*] role properties ordered
end

association Belief_property_Property between
  Belief[*] role source_property
  Property[0..1] role property
end

composition Environment_workspaces_Workspace between
  Environment[0..1] role source_workspaces
  Workspace[1..*] role workspaces ordered
end

association Event_signal_Signal between
  Event[*] role source_signal
  Signal[0..1] role signal
end

composition Group_links_Link between
  Group[0..1] role source_links
  Link[*] role links ordered
end

composition Group_roles_Role between
  Group[0..1] role source_roles
  Role[*] role roles ordered
end

composition Group_subGroups_Group between
  Group[0..1] role source_subGroups
  Group[*] role subGroups ordered
end

association Link_sourceRole_Role between
  Link[*] role source_sourceRole
  Role[1] role sourceRole
end

association Link_targetRole_Role between
  Link[*] role source_targetRole
  Role[1] role targetRole
end

association Mission_goals_OGoal between
  Mission[*] role source_goals
  OGoal[1..*] role goals ordered
end

association Norm_mission_Mission between
  Norm[*] role source_mission
  Mission[1] role mission
end

association Norm_role_Role between
  Norm[*] role source_role
  Role[1] role ecore_Norm_role
end

composition OGoal_plan_OPlan between
  OGoal[0..1] role source_plan
  OPlan[0..1] role plan
end

composition OPlan_subGoals_OGoal between
  OPlan[0..1] role source_subGoals
  OGoal[1..*] role subGoals ordered
end

association Operation_properties_Property between
  Operation[*] role source_Operation_properties
  Property[*] role properties ordered
end

association Operation_signals_Signal between
  Operation[*] role source_signals
  Signal[*] role signals ordered
end

composition Organization_groups_Group between
  Organization[0..1] role source_groups
  Group[*] role groups ordered
end

composition Organization_norms_Norm between
  Organization[0..1] role source_norms
  Norm[*] role norms ordered
end

composition Organization_schemes_Scheme between
  Organization[0..1] role source_schemes
  Scheme[*] role schemes ordered
end

composition Plan_actions_Action between
  Plan[0..1] role source_actions
  Action[*] role actions ordered
end

composition Plan_triggeringEvent_Event between
  Plan[0..1] role source_triggeringEvent
  Event[1] role triggeringEvent
end

association Role_superRoles_Role between
  Role[*] role source_superRoles
  Role[*] role superRoles ordered
end

composition Scheme_missions_Mission between
  Scheme[0..1] role source_missions
  Mission[1..*] role missions ordered
end

composition Scheme_rootGoal_OGoal between
  Scheme[0..1] role source_rootGoal
  OGoal[1] role rootGoal
end

composition Workspace_artifacts_Artifact between
  Workspace[0..1] role source_artifacts
  Artifact[*] role artifacts ordered
end


  self.orderEntries_R001->isUnique(rank) and self.orderEntries_R001->isUnique(value) and self.orderEntries_R001->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R001->size()) and self.orderEntries_R001->collect(value)->asSet() = self.groups->asSet()

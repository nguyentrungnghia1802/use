  self.orderEntries_R018->isUnique(rank) and self.orderEntries_R018->isUnique(value) and self.orderEntries_R018->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R018->size()) and self.orderEntries_R018->collect(value)->asSet() = self.plans->asSet()
context Agent inv order_R021:
  self.orderEntries_R021->isUnique(rank) and self.orderEntries_R021->isUnique(value) and self.orderEntries_R021->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R021->size()) and self.orderEntries_R021->collect(value)->asSet() = self.roles->asSet()
context Agent inv order_R022:
  self.orderEntries_R022->isUnique(rank) and self.orderEntries_R022->isUnique(value) and self.orderEntries_R022->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R022->size()) and self.orderEntries_R022->collect(value)->asSet() = self.workspaces->asSet()
context Artifact inv order_R035:
  self.orderEntries_R035->isUnique(rank) and self.orderEntries_R035->isUnique(value) and self.orderEntries_R035->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R035->size()) and self.orderEntries_R035->collect(value)->asSet() = self.agents->asSet()
context Artifact inv order_R033:
  self.orderEntries_R033->isUnique(rank) and self.orderEntries_R033->isUnique(value) and self.orderEntries_R033->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R033->size()) and self.orderEntries_R033->collect(value)->asSet() = self.ecore_Artifact_operations->asSet()
context Artifact inv order_R034:
  self.orderEntries_R034->isUnique(rank) and self.orderEntries_R034->isUnique(value) and self.orderEntries_R034->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R034->size()) and self.orderEntries_R034->collect(value)->asSet() = self.properties->asSet()
context Environment inv order_R030:
  self.orderEntries_R030->isUnique(rank) and self.orderEntries_R030->isUnique(value) and self.orderEntries_R030->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R030->size()) and self.orderEntries_R030->collect(value)->asSet() = self.workspaces->asSet()
context Group inv order_R006:
  self.orderEntries_R006->isUnique(rank) and self.orderEntries_R006->isUnique(value) and self.orderEntries_R006->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R006->size()) and self.orderEntries_R006->collect(value)->asSet() = self.links->asSet()
context Group inv order_R004:
  self.orderEntries_R004->isUnique(rank) and self.orderEntries_R004->isUnique(value) and self.orderEntries_R004->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R004->size()) and self.orderEntries_R004->collect(value)->asSet() = self.roles->asSet()

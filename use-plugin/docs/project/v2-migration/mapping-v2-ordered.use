  self.orderEntries_R003->isUnique(rank) and self.orderEntries_R003->isUnique(value) and self.orderEntries_R003->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R003->size()) and self.orderEntries_R003->collect(value)->asSet() = self.norms->asSet()
context Organization inv order_R002:
  self.orderEntries_R002->isUnique(rank) and self.orderEntries_R002->isUnique(value) and self.orderEntries_R002->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R002->size()) and self.orderEntries_R002->collect(value)->asSet() = self.schemes->asSet()
context Plan inv order_R025:
  self.orderEntries_R025->isUnique(rank) and self.orderEntries_R025->isUnique(value) and self.orderEntries_R025->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R025->size()) and self.orderEntries_R025->collect(value)->asSet() = self.actions->asSet()
context Role inv order_R008:
  self.orderEntries_R008->isUnique(rank) and self.orderEntries_R008->isUnique(value) and self.orderEntries_R008->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R008->size()) and self.orderEntries_R008->collect(value)->asSet() = self.agents->asSet()
context Role inv order_R007:
  self.orderEntries_R007->isUnique(rank) and self.orderEntries_R007->isUnique(value) and self.orderEntries_R007->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R007->size()) and self.orderEntries_R007->collect(value)->asSet() = self.superRoles->asSet()
context Scheme inv order_R014:
  self.orderEntries_R014->isUnique(rank) and self.orderEntries_R014->isUnique(value) and self.orderEntries_R014->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R014->size()) and self.orderEntries_R014->collect(value)->asSet() = self.missions->asSet()
context Workspace inv order_R032:
  self.orderEntries_R032->isUnique(rank) and self.orderEntries_R032->isUnique(value) and self.orderEntries_R032->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R032->size()) and self.orderEntries_R032->collect(value)->asSet() = self.agents->asSet()
context Workspace inv order_R031:
  self.orderEntries_R031->isUnique(rank) and self.orderEntries_R031->isUnique(value) and self.orderEntries_R031->forAll(e | e.rank >= 0 and e.rank < self.orderEntries_R031->size()) and self.orderEntries_R031->collect(value)->asSet() = self.artifacts->asSet()

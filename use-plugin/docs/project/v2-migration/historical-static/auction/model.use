  BodyTerm[*] role bodyterm ordered
end

association Body_firstAction_Action between
  Body[*] role source_firstAction
  Action[1] role firstAction
end

association Context_contextBelief_Belief between
  Context[*] role source_contextBelief
  Belief[*] role contextBelief ordered
end

association Context_contextRule_Rule between
  Context[*] role source_contextRule
  Rule[*] role contextRule ordered
end


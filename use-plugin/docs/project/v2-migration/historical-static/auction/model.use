model auction

abstract class AbsOperation
attributes
  awaitExpression : String
  await_timeExpression : String
  className : String
  signalExpression : String
end

abstract class Action < BodyTerm
attributes
  Expression : String
  Name : String
end

class Agent
attributes
  Name : String
end

class Artifact
attributes
  IDVar : String
  Parameter : String
  artifactName : String
  className : String
  isInitial : Boolean
end

class AuctionArtifact < Artifact
attributes
  open : Boolean
operations
  canBid(item : String, amount : Integer) : Boolean
  closeAuction()
  placeBid(item : String, amount : Integer)
  removeOpen()
end

class Belief
attributes
  Name : String
  isInitial : Boolean
end

class Body
attributes
  Name : String
end

abstract class BodyTerm
end

class Context
attributes
  Expression : String
end

class ExternalAction < Action
end

class FormationConstraints
attributes
  Name : String
  biDir : Boolean
  ecore_FormationConstraints_from : String
  scope : String
  to : String
  type : String
end

class FunctionalSpecification
end

class Goal
attributes
  Name : String
end

class Group
attributes
  Name : String
  max : Integer
  min : Integer
end

class GuardOperation < AbsOperation
end

class InternalAction < Action
end

class InternalOperation < AbsOperation
end

class Link
attributes
  biDir : Boolean
  ecore_Link_from : String
  scope : String
  to : String
  type : String
end

class LinkedOperation < AbsOperation
end

class MAS
attributes
  Name : String
  PlatformParamters : String
end

class MentalNotes < BodyTerm
end

class Message < InternalAction
attributes
  content : String
  isBroadcast : Boolean
end

class Mission
attributes
  max : Integer
  min : Integer
end

class Norm
attributes
  timeConstraint : String
  type : String
end

class NormativeSpecification
end

class OGoal
attributes
  Name : String
  isRootGoal : Boolean
end

class OPlan
attributes
  Parallel : Boolean
  ecore_OPlan_Sequence : Boolean
end

class ObsProperty
attributes
  Name : String
  ParamName : String
end

class Operation < AbsOperation
end

class Organisation
attributes
  id : String
end

class Plan
attributes
  Name : String
  argID : String
  asBeliefAddition : String
  asQuery : String
  atomicLabel : String
  isAtomic : String
  isInitial : Boolean
end

class Port
attributes
  Name : String
end

class Role
attributes
  Name : String
  max : Integer
  min : Integer
end

class Rule
attributes
  Expression : String
end

class Scheme
attributes
  PlanOperator : String
end

class StructuralSpecification
end

class TriggeringEvent < Action
attributes
  deletion : Boolean
  ds : String
  isInitial : Boolean
  isSeparateIntention : Boolean
  ttf : Integer
end

class Workspace
attributes
  Host : String
  Name : String
  Path : String
end

association AbsOperation_RefObsproperty_ObsProperty between
  AbsOperation[*] role source_RefObsproperty
  ObsProperty[*] role RefObsproperty ordered
end

association Action_nextAction_Action between
  Action[*] role source_nextAction
  Action[0..1] role nextAction
end

association Agent_artifact_Artifact between
  Agent[*] role source_Agent_artifact
  Artifact[*] role artifact ordered
end

composition Agent_belief_Belief between
  Agent[0..1] role source_belief
  Belief[*] role belief ordered
end

composition Agent_hasGoal_Goal between
  Agent[0..1] role source_hasGoal
  Goal[*] role hasGoal ordered
end

association Agent_joinWorkspace_Workspace between
  Agent[*] role source_joinWorkspace
  Workspace[*] role joinWorkspace ordered
end

composition Agent_plan_Plan between

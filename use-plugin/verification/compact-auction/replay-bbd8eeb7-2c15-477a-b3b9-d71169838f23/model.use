constraints
context OrgContext inv CslV4RoleCompatibility:
  self.roles->forAll( r1:RoleOccurrence, r2:RoleOccurrence | (((r1 = r2) or (r1.player <> r2.player)) or false) )

context self : Auction
  @AuthoredOclSource(bodyEnd="143", bodyStart="122", clause64="Tm9ubmVnYXRpdmVQcmljZQ==", kind="INVARIANT", line="2", source64="YXV0aG9yZWQtb2Ns", sourceHash="3f1e31aeb187a65cddf204b8d5a921b2d7f214b5e7bb121fd4d66fb3a6786f1b")
  inv NonnegativePrice:
    (self.best_bid >= 0)

context self : Auction
    @AuthoredOclSource(bodyEnd="243", bodyStart="179", clause64="UHVibGlzaGVkV2lubmVy", kind="INVARIANT", line="3", source64="YXV0aG9yZWQtb2Ns", sourceHash="3f1e31aeb187a65cddf204b8d5a921b2d7f214b5e7bb121fd4d66fb3a6786f1b")
    inv PublishedWinner:
      ((self.winner = 'no_winner') or (self.winner = self.currentWinner))

context Auction::bid(amount : Real)
      @AuthoredOclSource(bodyEnd="434", bodyStart="419", clause64="UnVubmluZ0ZvckJpZA==", kind="PRE", line="8", source64="YXV0aG9yZWQtb2Ns", sourceHash="3f1e31aeb187a65cddf204b8d5a921b2d7f214b5e7bb121fd4d66fb3a6786f1b")
      pre RunningForBid: self.running

context Auction::start(service : String)
      @AuthoredOclSource(bodyEnd="313", bodyStart="294", clause64="SWRsZQ==", kind="PRE", line="5", source64="YXV0aG9yZWQtb2Ns", sourceHash="3f1e31aeb187a65cddf204b8d5a921b2d7f214b5e7bb121fd4d66fb3a6786f1b")
      pre Idle: not self.running

context Auction::start(service : String)
      @AuthoredOclSource(bodyEnd="364", bodyStart="325", clause64="T3BlbmVk", kind="POST", line="6", source64="YXV0aG9yZWQtb2Ns", sourceHash="3f1e31aeb187a65cddf204b8d5a921b2d7f214b5e7bb121fd4d66fb3a6786f1b")
      post Opened: (self.running and (self.task = service))

context Auction::stop()
      @AuthoredOclSource(bodyEnd="524", bodyStart="505", clause64="Q2xvc2Vk", kind="POST", line="11", source64="YXV0aG9yZWQtb2Ns", sourceHash="3f1e31aeb187a65cddf204b8d5a921b2d7f214b5e7bb121fd4d66fb3a6786f1b")
      post Closed: not self.running

context Auction::stop()
      @AuthoredOclSource(bodyEnd="493", bodyStart="478", clause64="UnVubmluZ0ZvclN0b3A=", kind="PRE", line="10", source64="YXV0aG9yZWQtb2Ns", sourceHash="3f1e31aeb187a65cddf204b8d5a921b2d7f214b5e7bb121fd4d66fb3a6786f1b")
      pre RunningForStop: self.running


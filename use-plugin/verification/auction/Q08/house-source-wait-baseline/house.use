@ProjectionPolicy(version="3.0.0")
@DomainProjection(javaClass64="", kind="workspace", sourceId64="cHJvamVjdGlvbi1iYXNlOldvcmtzcGFjZQ")
class Workspace
attributes
  @ProjectionAttribute(provenance="semantic-contract", category="DOMAIN")
  name : String
end

constraints
context Mission
  @RuntimeConstraint(bodyHash="e4a96c443140b874c4d3d1987cbb2e5f342faddfc1c155588789cd07cb2bcb23", provenance="CORE:GOAL:MissionGoalContext", capabilities="", enforcement="REPORT_ONLY", severity="HARD", origin="CORE")
  inv MissionGoalContext:
    self.missionGoals->forAll( g:OrganizationalGoal | (g.goalScheme->asSet() = self.missionScheme->asSet()) )

context OrganizationalGoal
    @RuntimeConstraint(bodyHash="ab2010c535a8225fd32129ddfe0d7ce47c618947894b922bf675061f451a34ad", provenance="CORE:GOAL:GoalAcyclic", capabilities="", enforcement="REPORT_ONLY", severity="HARD", origin="CORE")
    inv GoalAcyclic:
      self.subGoals->closure( g:OrganizationalGoal | g.subGoals )->excludes(self)

context OrganizationalGoal
      @RuntimeConstraint(bodyHash="9d287b909140ab32a1256010deeec5657bb6c6e0ab9433ce25345933070ef4e6", provenance="CORE:GOAL:GoalCommittedResponsibility", capabilities="runtime.moise.goalState.v1", enforcement="REPORT_ONLY", severity="HARD", origin="CORE")
      inv GoalCommittedResponsibility:
        (not self.runtimeState.isUndefined() implies (self.goalCommittedAgents->asSet() = self.referencingMissions->collect( $e:Mission | $e.committedAgents )->asSet()))

context OrganizationalGoal
        @RuntimeConstraint(bodyHash="4871593c6192b49856d21aebe6e4a6fb586eac49eb2f7c8b9ae8e76b56de8af1", provenance="CORE:GOAL:GoalDecompositionContext", capabilities="", enforcement="REPORT_ONLY", severity="HARD", origin="CORE")
        inv GoalDecompositionContext:
          self.subGoals->forAll( g:OrganizationalGoal | (g.goalScheme->asSet() = self.goalScheme->asSet()) )

context OrganizationalGoal
          @RuntimeConstraint(bodyHash="12a5ab4c50bc1028685d067b32c212c949dfb81349fc139150aa5896dc7b0fda", provenance="CORE:GOAL:GoalSequenceOrdinals", capabilities="", enforcement="REPORT_ONLY", severity="HARD", origin="CORE")
          inv GoalSequenceOrdinals:
            ((self.decompositionOperator = 'sequence') implies (self.subGoals->isUnique( g:OrganizationalGoal | g.orderInParent ) and self.subGoals->forAll( g:OrganizationalGoal | ((not g.orderInParent.isUndefined() and (g.orderInParent >= 0)) and (g.orderInParent < self.subGoals->size())) )))

context OrganizationalGoal
            @RuntimeConstraint(bodyHash="accfef7713659b34bc687dd01cadcc08c258630b8b17b8761a8335867a6ef2c5", provenance="CORE:GOAL:GoalStateContext", capabilities="runtime.moise.goalState.v1", enforcement="REPORT_ONLY", severity="HARD", origin="CORE")
            inv GoalStateContext:
              (not self.runtimeState.isUndefined() implies (self.goalScheme->size() = 1))

context self : Agent inv StableIdentity:
              Agent.allInstances()->forAll( a:Agent | not a.name.isUndefined() )

context self : Agent inv DomainBeliefs:
              self.beliefs->forAll( b:Belief | not b.literal.isUndefined() )


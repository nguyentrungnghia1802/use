context Console::printMsg(msg : String)
    @AuthoredOclSource(bodyEnd="178", bodyStart="142", clause64="Q291bnRJbmNyZW1lbnRlZA==", kind="POST", line="4", source64="YXV0aG9yZWQtb2Ns", sourceHash="2f8febd764e6f8afb7e44e0a5fd940264d5a9cb23d5f1f1d3fae4909104e71ba")

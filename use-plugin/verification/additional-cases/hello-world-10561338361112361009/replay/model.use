    (self.numMsg >= 0)

context Console::printMsg(msg : String)
    @AuthoredOclSource(bodyEnd="120", bodyStart="113", clause64="Q2FuUHJpbnQ=", kind="PRE", line="3", source64="YXV0aG9yZWQtb2Ns", sourceHash="2f8febd764e6f8afb7e44e0a5fd940264d5a9cb23d5f1f1d3fae4909104e71ba")

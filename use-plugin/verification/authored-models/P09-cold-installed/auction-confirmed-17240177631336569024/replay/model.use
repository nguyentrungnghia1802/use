@SemanticRuntimeHelper(id64="aGVscGVyOkRvbWFpbkVudGl0eQ==", kind="M0_EXTENSION")
@DomainProjection(javaClass64="", kind="observer-helper", sourceId64="aGVscGVyOkRvbWFpbkVudGl0eQ")
abstract class DomainEntity
end

constraints
context OrgContext inv CslV4RoleCompatibility:
  self.roles->forAll( r1:RoleOccurrence, r2:RoleOccurrence | (((((((((r1 = r2) or (r1.player <> r2.player)) or (r1.oclIsKindOf(auction_capabilities) and r2.oclIsKindOf(auction_capabilities))) or (r1.oclIsKindOf(auction_capabilities) and r2.oclIsKindOf(auctioneer))) or (r1.oclIsKindOf(auction_capabilities) and r2.oclIsKindOf(participant))) or (r1.oclIsKindOf(auctioneer) and r2.oclIsKindOf(auction_capabilities))) or (r1.oclIsKindOf(auctioneer) and r2.oclIsKindOf(auctioneer))) or (r1.oclIsKindOf(participant) and r2.oclIsKindOf(auction_capabilities))) or (r1.oclIsKindOf(participant) and r2.oclIsKindOf(participant))) )

context auctionGroup inv AuctioneerPopulation:
  (self.auctioneer->size() = 1)

context auctionGroup inv ParticipantPopulation:
  (self.participant->size() <= 300)

context self : AuctionMonitor
  @AuthoredOclSource(bodyEnd="3786", bodyStart="3039", clause64="Q29uZmlybWVkQmlkRXZpZGVuY2U=", kind="INVARIANT", line="61", source64="YXV0aG9yZWQtb2Ns", sourceHash="7550f0f817f7ce6112dfe3aba800bff77bae52138de189858f2076534ea8234c")
  inv ConfirmedBidEvidence:
    (self.bidDoneBy->forAll( a:String | self.actualBidBy->includes(a) ) and ((self.bidSatisfiedConfirmedAt >= 0) implies (self.adminBidOverride or self.bidCommittedBy->exists( a:String | (self.bidDoneBy->includes(a) and self.actualBidBy->includes(a)) ))))

context self : AuctionMonitor
    @AuthoredOclSource(bodyEnd="2991", bodyStart="1843", clause64="Q29uZmlybWVkU2NoZW1lT3JkZXI=", kind="INVARIANT", line="40", source64="YXV0aG9yZWQtb2Ns", sourceHash="7550f0f817f7ce6112dfe3aba800bff77bae52138de189858f2076534ea8234c")
    inv ConfirmedSchemeOrder:
      (((((self.bidEnabledConfirmedAt >= 0) implies ((self.startSatisfiedConfirmedAt >= 0) and (self.startSatisfiedConfirmedAt <= self.bidEnabledConfirmedAt))) and ((self.bidSatisfiedConfirmedAt >= 0) implies ((self.bidEnabledConfirmedAt >= 0) and (self.bidEnabledConfirmedAt <= self.bidSatisfiedConfirmedAt)))) and ((self.decideEnabledConfirmedAt >= 0) implies ((self.bidSatisfiedConfirmedAt >= 0) and (self.bidSatisfiedConfirmedAt <= self.decideEnabledConfirmedAt)))) and ((self.decideSatisfiedConfirmedAt >= 0) implies ((self.decideEnabledConfirmedAt >= 0) and (self.decideEnabledConfirmedAt <= self.decideSatisfiedConfirmedAt))))

context self : AuctionObligation
      @AuthoredOclSource(bodyEnd="4102", bodyStart="3831", clause64="V2l0aGluRGVhZGxpbmU=", kind="INVARIANT", line="77", source64="YXV0aG9yZWQtb2Ns", sourceHash="7550f0f817f7ce6112dfe3aba800bff77bae52138de189858f2076534ea8234c")
      inv WithinDeadline:
        (((self.deadlineAt = (self.activatedAt + if (self.goal = 'bid') then 10000 else 3600000 endif)) and not self.unfulfilled) and (if (self.endedAt >= 0) then self.endedAt else self.monitor.now endif <= self.deadlineAt))

context Auction::bid(amount : Real)
        @AuthoredOclSource(bodyEnd="1389", bodyStart="1370", clause64="UnVubmluZ0ZvckJpZA==", kind="PRE", line="26", source64="YXV0aG9yZWQtb2Ns", sourceHash="7550f0f817f7ce6112dfe3aba800bff77bae52138de189858f2076534ea8234c")
        pre RunningForBid: self.running

context Auction::start(service : String)
        @AuthoredOclSource(bodyEnd="1261", bodyStart="1239", clause64="SWRsZQ==", kind="PRE", line="20", source64="YXV0aG9yZWQtb2Ns", sourceHash="7550f0f817f7ce6112dfe3aba800bff77bae52138de189858f2076534ea8234c")
        pre Idle: not self.running

context Auction::start(service : String)
        @AuthoredOclSource(bodyEnd="1316", bodyStart="1273", clause64="T3BlbmVk", kind="POST", line="22", source64="YXV0aG9yZWQtb2Ns", sourceHash="7550f0f817f7ce6112dfe3aba800bff77bae52138de189858f2076534ea8234c")
        post Opened: (self.running and (self.task = service))

context Auction::stop()
        @AuthoredOclSource(bodyEnd="1795", bodyStart="1462", clause64="Q2xvc2Vk", kind="POST", line="32", source64="YXV0aG9yZWQtb2Ns", sourceHash="7550f0f817f7ce6112dfe3aba800bff77bae52138de189858f2076534ea8234c")
        post Closed: not self.running

context Auction::stop()
        @AuthoredOclSource(bodyEnd="1450", bodyStart="1432", clause64="UnVubmluZ0ZvclN0b3A=", kind="PRE", line="30", source64="YXV0aG9yZWQtb2Ns", sourceHash="7550f0f817f7ce6112dfe3aba800bff77bae52138de189858f2076534ea8234c")
        pre RunningForStop: self.running


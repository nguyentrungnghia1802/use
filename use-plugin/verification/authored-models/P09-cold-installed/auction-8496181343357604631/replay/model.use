@SemanticRuntimeHelper(id64="aGVscGVyOkRvbWFpbkVudGl0eQ==", kind="M0_EXTENSION")
@DomainProjection(javaClass64="", kind="observer-helper", sourceId64="aGVscGVyOkRvbWFpbkVudGl0eQ")
abstract class DomainEntity
end

constraints
context OrgContext inv CslV4RoleCompatibility:
  self.roles->forAll( r1:RoleOccurrence, r2:RoleOccurrence | (((((((((r1 = r2) or (r1.player <> r2.player)) or (r1.oclIsKindOf(auction_capabilities) and r2.oclIsKindOf(auction_capabilities))) or (r1.oclIsKindOf(auction_capabilities) and r2.oclIsKindOf(auctioneer))) or (r1.oclIsKindOf(auction_capabilities) and r2.oclIsKindOf(participant))) or (r1.oclIsKindOf(auctioneer) and r2.oclIsKindOf(auction_capabilities))) or (r1.oclIsKindOf(auctioneer) and r2.oclIsKindOf(auctioneer))) or (r1.oclIsKindOf(participant) and r2.oclIsKindOf(auction_capabilities))) or (r1.oclIsKindOf(participant) and r2.oclIsKindOf(participant))) )

context auctionGroup inv AuctioneerPopulation:
  (self.auctioneer->size() = 1)

context auctionGroup inv ParticipantPopulation:
  (self.participant->size() <= 300)

context self : AuctionMonitor
  @AuthoredOclSource(bodyEnd="3533", bodyStart="2795", clause64="QmlkRXZpZGVuY2U=", kind="INVARIANT", line="60", source64="YXV0aG9yZWQtb2Ns", sourceHash="07f692a7412cd877203846081018d846076b7fd149392db1accc5e83ad4fa0d6")
  inv BidEvidence:
    (self.bidDoneBy->forAll( a:String | self.actualBidBy->includes(a) ) and ((self.bidSatisfiedAt >= 0) implies (self.adminBidOverride or self.bidCommittedBy->exists( a:String | (self.bidDoneBy->includes(a) and self.actualBidBy->includes(a)) ))))

context self : AuctionMonitor
    @AuthoredOclSource(bodyEnd="2756", bodyStart="1760", clause64="U2NoZW1lT3JkZXI=", kind="INVARIANT", line="39", source64="YXV0aG9yZWQtb2Ns", sourceHash="07f692a7412cd877203846081018d846076b7fd149392db1accc5e83ad4fa0d6")
    inv SchemeOrder:
      (((((self.bidEnabledAt >= 0) implies ((self.startSatisfiedAt >= 0) and (self.startSatisfiedAt <= self.bidEnabledAt))) and ((self.bidSatisfiedAt >= 0) implies ((self.bidEnabledAt >= 0) and (self.bidEnabledAt <= self.bidSatisfiedAt)))) and ((self.decideEnabledAt >= 0) implies ((self.bidSatisfiedAt >= 0) and (self.bidSatisfiedAt <= self.decideEnabledAt)))) and ((self.decideSatisfiedAt >= 0) implies ((self.decideEnabledAt >= 0) and (self.decideEnabledAt <= self.decideSatisfiedAt))))

context self : AuctionObligation
      @AuthoredOclSource(bodyEnd="3849", bodyStart="3578", clause64="V2l0aGluRGVhZGxpbmU=", kind="INVARIANT", line="76", source64="YXV0aG9yZWQtb2Ns", sourceHash="07f692a7412cd877203846081018d846076b7fd149392db1accc5e83ad4fa0d6")
      inv WithinDeadline:
        (((self.deadlineAt = (self.activatedAt + if (self.goal = 'bid') then 10000 else 3600000 endif)) and not self.unfulfilled) and (if (self.endedAt >= 0) then self.endedAt else self.monitor.now endif <= self.deadlineAt))

context Auction::bid(amount : Real)
        @AuthoredOclSource(bodyEnd="1316", bodyStart="1297", clause64="UnVubmluZ0ZvckJpZA==", kind="PRE", line="25", source64="YXV0aG9yZWQtb2Ns", sourceHash="07f692a7412cd877203846081018d846076b7fd149392db1accc5e83ad4fa0d6")
        pre RunningForBid: self.running

context Auction::start(service : String)
        @AuthoredOclSource(bodyEnd="1188", bodyStart="1166", clause64="SWRsZQ==", kind="PRE", line="19", source64="YXV0aG9yZWQtb2Ns", sourceHash="07f692a7412cd877203846081018d846076b7fd149392db1accc5e83ad4fa0d6")
        pre Idle: not self.running

context Auction::start(service : String)
        @AuthoredOclSource(bodyEnd="1243", bodyStart="1200", clause64="T3BlbmVk", kind="POST", line="21", source64="YXV0aG9yZWQtb2Ns", sourceHash="07f692a7412cd877203846081018d846076b7fd149392db1accc5e83ad4fa0d6")
        post Opened: (self.running and (self.task = service))

context Auction::stop()
        @AuthoredOclSource(bodyEnd="1721", bodyStart="1389", clause64="Q2xvc2Vk", kind="POST", line="31", source64="YXV0aG9yZWQtb2Ns", sourceHash="07f692a7412cd877203846081018d846076b7fd149392db1accc5e83ad4fa0d6")
        post Closed: not self.running

context Auction::stop()
        @AuthoredOclSource(bodyEnd="1377", bodyStart="1359", clause64="UnVubmluZ0ZvclN0b3A=", kind="PRE", line="29", source64="YXV0aG9yZWQtb2Ns", sourceHash="07f692a7412cd877203846081018d846076b7fd149392db1accc5e83ad4fa0d6")
        pre RunningForStop: self.running


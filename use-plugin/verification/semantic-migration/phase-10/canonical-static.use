constraints
context Counter inv Nonnegative:
  (self.p >= 0)

context OrgContext inv CslV4RoleCompatibility:
  self.roles->forAll( r1:RoleOccurrence, r2:RoleOccurrence | ((((((r1 = r2) or (r1.player <> r2.player)) or (r1.oclIsKindOf(R_soc) and r2.oclIsKindOf(R_soc))) or (r1.oclIsKindOf(R_soc) and r2.oclIsKindOf(R_worker))) or (r1.oclIsKindOf(R_worker) and r2.oclIsKindOf(R_soc))) or (r1.oclIsKindOf(R_worker) and r2.oclIsKindOf(R_worker))) )


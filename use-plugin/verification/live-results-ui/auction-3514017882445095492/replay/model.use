@SemanticRuntimeHelper(id64="aGVscGVyOkRvbWFpbkVudGl0eQ==", kind="M0_EXTENSION")
@DomainProjection(javaClass64="", kind="observer-helper", sourceId64="aGVscGVyOkRvbWFpbkVudGl0eQ")
abstract class DomainEntity
end

constraints
context OrgContext inv CslV4RoleCompatibility:
  self.roles->forAll( r1:RoleOccurrence, r2:RoleOccurrence | ((((r1 = r2) or (r1.player <> r2.player)) or (r1.oclIsKindOf(auctioneer) and r2.oclIsKindOf(auctioneer))) or (r1.oclIsKindOf(participant) and r2.oclIsKindOf(participant))) )

context auctionGroup
  @DeclarativeInvariantActivation(id="operational-auctioneer-population", policy="LATCH_ONCE_QUALIFIED/1.0", program="957856246f9af9bb6af74e59de1f2ebe93fa060ec48ecdf30907ed0289f0fbac", table="population-ready-groups")
  inv AuctioneerPopulation:
    (self.auctioneer->size() = 1)

context auctionGroup inv ParticipantPopulation:
    (self.participant->size() <= 300)

context self : AuctionMonitor
    @AuthoredOclSource(bodyEnd="1719", bodyStart="579", clause64="Q29uZmlybWVkU2NoZW1lT3JkZXI=", kind="INVARIANT", line="19", source64="TU9ERUxfTkFUSVZFX09DTC8xLjArYXV0aG9yZWQtb2Ns", sourceHash="bede81e993aadd5d45e453e02f8b335e4d32ef026e0a97922f82a176b52242c1")
    inv ConfirmedSchemeOrder:
      (((((self.bidEnabledConfirmedAt >= 0) implies ((self.startSatisfiedConfirmedAt >= 0) and (self.startSatisfiedConfirmedAt <= self.bidEnabledConfirmedAt))) and ((self.bidSatisfiedConfirmedAt >= 0) implies ((self.bidEnabledConfirmedAt >= 0) and (self.bidEnabledConfirmedAt <= self.bidSatisfiedConfirmedAt)))) and ((self.decideEnabledConfirmedAt >= 0) implies ((self.bidSatisfiedConfirmedAt >= 0) and (self.bidSatisfiedConfirmedAt <= self.decideEnabledConfirmedAt)))) and ((self.decideSatisfiedConfirmedAt >= 0) implies ((self.decideEnabledConfirmedAt >= 0) and (self.decideEnabledConfirmedAt <= self.decideSatisfiedConfirmedAt))))

context self : AuctionMonitor
      @AuthoredOclSource(bodyEnd="2704", bodyStart="1766", clause64="T2JzZXJ2ZWRCaWRFdmlkZW5jZQ==", kind="INVARIANT", line="40", source64="TU9ERUxfTkFUSVZFX09DTC8xLjArYXV0aG9yZWQtb2Ns", sourceHash="bede81e993aadd5d45e453e02f8b335e4d32ef026e0a97922f82a176b52242c1")
      inv ObservedBidEvidence:
        (self.bidDoneBy->forAll( a:String | self.actualBidBy->includes(a) ) and (self.bidSatisfiedObserved implies (self.adminBidOverride or self.bidCommittedBy->exists( a:String | (self.bidDoneBy->includes(a) and self.actualBidBy->includes(a)) ))))

context Auction::bid(amount : Real)
        @AuthoredOclSource(bodyEnd="320", bodyStart="298", clause64="UnVubmluZ0ZvckJpZA==", kind="PRE", line="9", source64="TU9ERUxfTkFUSVZFX09DTC8xLjArYXV0aG9yZWQtb2Ns", sourceHash="bede81e993aadd5d45e453e02f8b335e4d32ef026e0a97922f82a176b52242c1")
        pre RunningForBid: self.running

context Auction::start(service : String)
        @AuthoredOclSource(bodyEnd="185", bodyStart="161", clause64="SWRsZQ==", kind="PRE", line="3", source64="TU9ERUxfTkFUSVZFX09DTC8xLjArYXV0aG9yZWQtb2Ns", sourceHash="bede81e993aadd5d45e453e02f8b335e4d32ef026e0a97922f82a176b52242c1")
        pre Idle: not self.running

context Auction::start(service : String)
        @AuthoredOclSource(bodyEnd="243", bodyStart="197", clause64="T3BlbmVk", kind="POST", line="5", source64="TU9ERUxfTkFUSVZFX09DTC8xLjArYXV0aG9yZWQtb2Ns", sourceHash="bede81e993aadd5d45e453e02f8b335e4d32ef026e0a97922f82a176b52242c1")
        post Opened: (self.running and (self.task = service))

context Auction::stop()
        @AuthoredOclSource(bodyEnd="531", bodyStart="396", clause64="Q2xvc2Vk", kind="POST", line="15", source64="TU9ERUxfTkFUSVZFX09DTC8xLjArYXV0aG9yZWQtb2Ns", sourceHash="bede81e993aadd5d45e453e02f8b335e4d32ef026e0a97922f82a176b52242c1")
        post Closed: not self.running

context Auction::stop()
        @AuthoredOclSource(bodyEnd="384", bodyStart="364", clause64="UnVubmluZ0ZvclN0b3A=", kind="PRE", line="13", source64="TU9ERUxfTkFUSVZFX09DTC8xLjArYXV0aG9yZWQtb2Ns", sourceHash="bede81e993aadd5d45e453e02f8b335e4d32ef026e0a97922f82a176b52242c1")

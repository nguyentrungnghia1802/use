+                        .findFirst();
+                if (found.isEmpty() && targetKind == SemanticBindingIndex.Kind.ORG_CONTEXT) {
+                    meta.put("contextAbstraction", "PROJECT_EXECUTION_VIEW/1.0");
+                }

+    private static String resolveSourceNodeId(
+            NormalizedSourceModel source,
+            SourceReference ref,
+            SemanticBindingIndex.Kind targetKind,
+            Map<String, String> meta) {
+        String projectNodeId = findProjectNodeId(source);
+        if (targetKind == SemanticBindingIndex.Kind.ENTITY) {
+            String className = switch (ref) {
+                case SourceReference.ArtifactRef ar -> ar.className();
+                case SourceReference.ArtifactPropertyRef pr -> pr.className();
+                case SourceReference.ArtifactFieldRef fr -> fr.className();
+                case SourceReference.ArtifactOpRef or -> or.className();
+                default -> "";
+            };
+            String exactAlias = org.tzi.use.plugins.jacamo.codegrounded.use.DomainProjection.artifactId(className);
+            for (var n : source.nodes()) {
+                if (n.id().equals(exactAlias)) return n.id();
+                if ("Artifact".equals(n.concept()) && n.layer() == NormalizedSourceModel.Layer.MODEL_DEFINITION
+                        && !Set.of("CARTAGO_ARTIFACT", "CARTAGO_ARTIFACT_INFO").contains(n.sourceKind())) {

+                        .findFirst()
+                        .orElse(projectNodeId);
+            }
+            case SourceReference.AslGoalRef agr -> {
+                String base = agr.aslPath().endsWith(".asl") ? agr.aslPath() : agr.aslPath() + ".asl";
+                yield source.nodes().stream()
+                        .filter(n -> "JASON_AGENT_PROGRAM".equals(n.sourceKind()) && String.valueOf(n.features().getOrDefault("sourceUri", new NormalizedSourceModel.Feature("", true, "")).value()).endsWith(base))
+                        .map(NormalizedSourceModel.Node::id)
+                        .findFirst()
+                        .orElse(projectNodeId);
+            }
+            case SourceReference.AslPlanStepRef psr -> {
+                String base = psr.aslPath().endsWith(".asl") ? psr.aslPath() : psr.aslPath() + ".asl";
+                yield source.nodes().stream()
+                        .filter(n -> "JASON_AGENT_PROGRAM".equals(n.sourceKind()) && String.valueOf(n.features().getOrDefault("sourceUri", new NormalizedSourceModel.Feature("", true, "")).value()).endsWith(base))
+                        .map(NormalizedSourceModel.Node::id)
+                        .findFirst()
+                        .orElse(projectNodeId);
+            }
+        };
+    }

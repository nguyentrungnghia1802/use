+            case SourceReference.ArtifactRef ar -> {
+                String alias = org.tzi.use.plugins.jacamo.codegrounded.use.DomainProjection.artifactId(ar.className());
+                yield source.nodes().stream().filter(n -> n.id().equals(alias) || ar.className().equals(n.sourceJavaFqcn())).map(NormalizedSourceModel.Node::id).findFirst().orElse(projectNodeId);
+            }
+            case SourceReference.ArtifactPropertyRef pr -> {
+                String alias = org.tzi.use.plugins.jacamo.codegrounded.use.DomainProjection.artifactId(pr.className());
+                yield source.nodes().stream().filter(n -> n.id().equals(alias)).map(NormalizedSourceModel.Node::id).findFirst().orElse(projectNodeId);
+            }
+            case SourceReference.ArtifactFieldRef fr -> {
+                String alias = org.tzi.use.plugins.jacamo.codegrounded.use.DomainProjection.artifactId(fr.className());
+                yield source.nodes().stream().filter(n -> n.id().equals(alias)).map(NormalizedSourceModel.Node::id).findFirst().orElse(projectNodeId);
+            }
+            case SourceReference.ArtifactOpRef or -> {
+                String alias = org.tzi.use.plugins.jacamo.codegrounded.use.DomainProjection.artifactId(or.className());
+                yield source.nodes().stream().filter(n -> n.id().equals(alias)).map(NormalizedSourceModel.Node::id).findFirst().orElse(projectNodeId);
+            }
+            case SourceReference.MoiseGroupRef gr -> {
+                var found = source.nodes().stream()
+                        .filter(n -> "Group".equals(n.concept()) && gr.groupName().equals(String.valueOf(n.features().getOrDefault("groupId", new NormalizedSourceModel.Feature("", true, "")).value())))

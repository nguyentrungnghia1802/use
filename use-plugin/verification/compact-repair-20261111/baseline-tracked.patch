+            }
+            case SourceReference.MoiseRoleRef rr -> source.nodes().stream()
+                    .filter(n -> "Role".equals(n.concept()) && rr.roleName().equals(String.valueOf(n.features().getOrDefault("roleId", new NormalizedSourceModel.Feature("", true, "")).value())))
+                    .map(NormalizedSourceModel.Node::id)
+                    .findFirst()
+                    .orElse(projectNodeId);
+            case SourceReference.MoiseSchemeRef sr -> {
+                if (targetKind == SemanticBindingIndex.Kind.ORG_CONTEXT) {
+                    meta.put("contextAbstraction", "SCHEME_EXECUTION_VIEW/1.0");
+                }
+                yield source.nodes().stream()
+                        .filter(n -> "MOISE_SCHEME".equals(n.sourceKind()) && sr.schemeName().equals(String.valueOf(n.features().getOrDefault("schemeId", new NormalizedSourceModel.Feature("", true, "")).value())))
+                        .map(NormalizedSourceModel.Node::id)
+                        .findFirst()
+                        .orElse(projectNodeId);
+            }
+            case SourceReference.MoiseGoalRef mgr -> source.nodes().stream()
+                    .filter(n -> "MOISE_GOAL".equals(n.sourceKind()) && mgr.goalName().equals(String.valueOf(n.features().getOrDefault("goalId", new NormalizedSourceModel.Feature("", true, "")).value())))
+                    .map(NormalizedSourceModel.Node::id)
+                    .findFirst()
+                    .orElse(projectNodeId);
+            case SourceReference.AgentRef ag -> {
+                String base = ag.agentOrProgram().endsWith(".asl") ? ag.agentOrProgram().substring(0, ag.agentOrProgram().length() - 4) : ag.agentOrProgram();

        <mxCell id="mUN7QUVWxazm6ZizcDI6-2" elementType="role" parent="1" style="ellipse;html=1;whiteSpace=wrap;strokeWidth=1.7;strokeColor=#2D7600;fillColor=#60a917;fontSize=18;spacing=8;fontFamily=Arial;fontColor=#ffffff;fontSize=17;" value="&lt;div style=&quot;text-align: start;&quot;&gt;&lt;font face=&quot;monospace&quot; style=&quot;font-size: 19px;&quot;&gt;&lt;span style=&quot;text-wrap-mode: nowrap; color: light-dark(rgb(36, 36, 57), rgb(0, 0, 0));&quot;&gt;auction_capabilities&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">

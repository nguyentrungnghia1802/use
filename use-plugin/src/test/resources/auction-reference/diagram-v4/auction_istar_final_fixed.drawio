        <mxCell id="rq_O_hfanHRNPlTsZUYV-33" elementType="task" owner="Participant" parent="rq_O_hfanHRNPlTsZUYV-6" postcondition="step.succeeded" precondition="step.enabled and self.running" sourceReference="auction_capabilities.asl:36-42; AuctionArtifact.java:34-44" style="shape=hexagon;perimeter=hexagonPerimeter;size=0.14;html=1;whiteSpace=wrap;strokeWidth=1.6;strokeColor=#2D7600;fillColor=#60a917;fontSize=16;spacing=10;fontFamily=Arial;fontColor=#ffffff;" tooltip="auction_capabilities.asl:36-42; AuctionArtifact.java:34-44&#xa;Task is fulfilled only on successful execution of the bound Jason/CArtAgO step." value="&lt;b&gt;Wait, then bid(amount)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;successful branch: random &amp;lt; 0.9&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="260" x="918" y="345" as="geometry" />

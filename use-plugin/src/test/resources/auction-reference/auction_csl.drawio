          <mxGeometry x="20" y="120" width="450" height="33" as="geometry" />
        </mxCell>
        <mxCell id="attr_task" parent="auction" vertex="1" value="task : String = 'no_task'" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#000000;fontSize=18;align=left;verticalAlign=top;" elementType="Attribute" name="task" dataType="String" optional="false" mutable="true" sourceReference="observable task; service remains text">
          <mxGeometry x="20" y="155" width="450" height="33" as="geometry" />
        </mxCell>
        <mxCell id="attr_best_bid" parent="auction" vertex="1" value="best_bid : Real" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#000000;fontSize=18;align=left;verticalAlign=top;" elementType="Attribute" name="best_bid" dataType="Real" optional="false" mutable="true" sourceReference="observable best_bid; init Double.MAX_VALUE">
          <mxGeometry x="20" y="190" width="450" height="33" as="geometry" />
        </mxCell>
        <mxCell id="attr_winner" parent="auction" vertex="1" value="winner : String = 'no_winner'" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#000000;fontSize=18;align=left;verticalAlign=top;" elementType="Attribute" name="winner" dataType="String" optional="false" mutable="true" sourceReference="observable Atom name, published by stop">
          <mxGeometry x="20" y="225" width="450" height="33" as="geometry" />
        </mxCell>
        <mxCell id="attr_currentWinner" parent="auction" vertex="1" value="currentWinner : String = 'no_winner' *" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#000000;fontSize=18;align=left;verticalAlign=top;" elementType="Attribute" name="currentWinner" dataType="String" optional="false" mutable="true" sourceReference="persistent Java field; NOT observable">
          <mxGeometry x="20" y="260" width="450" height="33" as="geometry" />
        </mxCell>
        <mxCell id="entity_note" parent="1" vertex="1" value="&lt;b&gt;Projection details&lt;/b&gt;&lt;br&gt;id = artifact name (a1 / a2), not an observable property.&lt;br&gt;All attributes are required; all except id are mutable.&lt;br&gt;* currentWinner is persistent, internal, non-observable.&lt;br&gt;winner is published only by stop().&lt;br&gt;best_bid starts at finite Double.MAX_VALUE." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#000000;fontSize=17;align=left;verticalAlign=top;">
          <mxGeometry x="1285" y="820" width="435" height="190" as="geometry" />
        </mxCell>
        <mxCell id="contains_group" parent="1" edge="1" source="org" target="group" value="orgctx" relation="declarationContainment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.6;startArrow=diamond;startFill=1;startSize=13;endArrow=none;fontFamily=Arial;fontColor=#000000;fontSize=17;labelBackgroundColor=#FFFFFF;exitX=0.19;exitY=1;entryX=0.5;entryY=0.173913;entryPerimeter=0;" sourceReference="csl.ecore OrgCtx.orgctx; auction.jcm:21-22">

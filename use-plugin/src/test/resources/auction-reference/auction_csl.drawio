        <mxCell id="configuration" parent="1" vertex="1" value="&lt;b&gt;Configured M0 population&lt;/b&gt;&lt;br&gt;&lt;br&gt;aorg contains agrp.&lt;br&gt;bob plays auctioneer.&lt;br&gt;alice, maria, francois, giacomo play participant.&lt;br&gt;&lt;br&gt;Named domain artifacts a1 and a2 are created by&lt;br&gt;the two start plans; their Ids correlate scheme&lt;br&gt;arguments with the corresponding Auction Entity." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#000000;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="60" y="170" width="470" height="235" as="geometry" />
        </mxCell>

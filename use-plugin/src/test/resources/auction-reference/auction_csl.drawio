          <mxGeometry x="60" y="1050" width="1680" height="125" as="geometry" />
        </mxCell>
        <mxCell id="population" parent="1" vertex="1" value="&lt;b&gt;Source population constraints (Phi), not declaration-edge multiplicities&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot;&gt;context auctionGroup inv AuctioneerPopulation: self.auctioneer-&amp;gt;size() = 1&lt;br&gt;context auctionGroup inv ParticipantPopulation: self.participant-&amp;gt;size() &amp;lt;= 300&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#000000;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry x="80" y="1065" width="1640" height="95" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" vertex="1" value="&lt;b&gt;Notation:&lt;/b&gt; folder = OrgCtx; capsule with person = Role; compartmented rectangle = Entity; filled diamond = CSL declaration containment.&lt;br&gt;Containment scopes M1 declarations; it does not impose M0 population or assert CArtAgO workspace ownership. No explicit Association, Generalization or Compatibility is invented." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#000000;fontSize=16;align=left;verticalAlign=top;">
          <mxGeometry x="60" y="1190" width="1680" height="58" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>

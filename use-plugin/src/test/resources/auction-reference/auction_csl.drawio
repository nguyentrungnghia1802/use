        <mxCell id="contains_auctioneer" parent="1" edge="1" source="group" target="auctioneer" value="roles" relation="declarationContainment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.6;startArrow=diamond;startFill=1;startSize=13;endArrow=none;fontFamily=Arial;fontColor=#000000;fontSize=17;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" sourceReference="csl.ecore OrgCtx.roles; auction-os.xml:21">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="650" y="710" />
              <mxPoint x="405" y="710" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="contains_participant" parent="1" edge="1" source="group" target="participant" value="roles" relation="declarationContainment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.6;startArrow=diamond;startFill=1;startSize=13;endArrow=none;fontFamily=Arial;fontColor=#000000;fontSize=17;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" sourceReference="csl.ecore OrgCtx.roles; auction-os.xml:22">
          <mxGeometry relative="1" as="geometry">

        <mxCell id="contains_auction" parent="1" edge="1" source="org" target="auction" value="entities" relation="declarationContainment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.6;startArrow=diamond;startFill=1;startSize=13;endArrow=none;fontFamily=Arial;fontColor=#000000;fontSize=17;labelBackgroundColor=#FFFFFF;exitX=0.83;exitY=1;entryX=0.5;entryY=0;" sourceReference="csl.ecore OrgCtx.entities; Id correspondence in auction_capabilities.asl:5-12,20-25">
          <mxGeometry relative="1" as="geometry">

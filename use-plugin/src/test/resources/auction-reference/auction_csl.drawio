        <mxCell id="attr_id" parent="auction" vertex="1" value="id : String {readOnly}" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#000000;fontSize=18;align=left;verticalAlign=top;" elementType="Attribute" name="id" dataType="String" optional="false" mutable="false" sourceReference="artifact name / goal argument Id">

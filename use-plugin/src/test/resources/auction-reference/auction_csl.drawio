<?xml version='1.0' encoding='utf-8'?>
<mxfile host="Electron" compressed="false" cslVersion="v4.0" cslSource="csl v4.0 AuctionState {&#10;    orgContext AuctionOrg {&#10;        orgContext auctionGroup {&#10;            role auctioneer;&#10;            role participant;&#10;        }&#10;        // Model scope: the organization coordinates the named auction artifacts.&#10;        // This is not physical ownership of a CArtAgO workspace/artifact.&#10;        entity Auction {&#10;            attribute id : String required;&#10;            attribute running : Boolean required mutable default false;&#10;            attribute task : String required mutable default 'no_task';&#10;            // Initial source value is Double.MAX_VALUE; retain it in a snapshot.&#10;            // No invented numeric default or bounded-domain sentinel is used.&#10;            attribute best_bid : Real required mutable;&#10;            attribute winner : String required mutable default 'no_winner';&#10;            // Source field, not an observable property. Requires explicit access.&#10;            attribute currentWinner : String required mutable default 'no_winner';&#10;        }&#10;    }&#10;&#10;    // Source role-population constraints, distinct from declaration containment.&#10;    context auctionGroup inv AuctioneerPopulation:&#10;        self.auctioneer-&gt;size() = 1;&#10;    context auctionGroup inv ParticipantPopulation:&#10;        self.participant-&gt;size() &lt;= 300;&#10;}&#10;" semanticAudit="{&quot;decisions&quot;: [[&quot;KEEP/MODIFY&quot;, &quot;auctionGroup&quot;, &quot;OrgCtx for group specification; agrp is its configured instance. No MOISE subgroup exists.&quot;, &quot;auction.jcm:21-27; auction-os.xml:19-24&quot;], [&quot;KEEP/MODIFY&quot;, &quot;auctioneer, participant&quot;, &quot;CSL Roles with no invented attributes or inheritance. Source population bounds are separate M0 constraints.&quot;, &quot;auction-os.xml:14-23; csl.ecore Role/OrgCtx&quot;], [&quot;KEEP/MODIFY&quot;, &quot;Auction&quot;, &quot;Passive Entity projection; id from artifact name, four observable scalar attributes retained with exact source names/types.&quot;, &quot;auction_capabilities.asl:19-25,32-38; AuctionArtifact.java:10-44&quot;], [&quot;ADD&quot;, &quot;AuctionOrg&quot;, &quot;Root OrgCtx for configured aorg; Auction domain declaration scoped here, not a physical workspace ownership assertion.&quot;, &quot;auction.jcm:21; auction_capabilities.asl:5-12; paper IV-C/Fig.6-7&quot;], [&quot;ADD&quot;, &quot;Auction.currentWinner&quot;, &quot;Persistent source String field; internal and non-observable. Needed to represent the stored candidate later published by stop.&quot;, &quot;AuctionArtifact.java:8,31,41&quot;], [&quot;ADD&quot;, &quot;AuctioneerPopulation / ParticipantPopulation&quot;, &quot;Source-backed role-instance population invariants, not cardinalities of M1 declaration containment.&quot;, &quot;auction-os.xml:21-22; CSL.g4:5-18; CslLayoutBuilder.java:56-66&quot;], [&quot;REMOVE&quot;, &quot;Bid / amount / bidderName&quot;, &quot;No persistent Bid record or history; an invocation is not a CSL Entity.&quot;, &quot;AuctionArtifact.java:34-44&quot;], [&quot;REMOVE&quot;, &quot;opens-closes / submits / offers&quot;, &quot;Operations are behavioral contracts, not stored structural relationships.&quot;, &quot;AuctionArtifact.java:18-44; CSL.g4:18&quot;], [&quot;REMOVE/REPLACE&quot;, &quot;auction sessions association&quot;, &quot;Replaced by explicit declaration scope under AuctionOrg; Id binds coordinated scheme and artifact. No invented Group-to-artifact business association.&quot;, &quot;auction_capabilities.asl:5-12,20-25&quot;], [&quot;DO NOT ADD&quot;, &quot;Service / Agent / Scheme / Mission / Norm / helper Entities&quot;, &quot;Service is a String; agent enactment is M0; intentions/deontic/observer data belong to other layers.&quot;, &quot;CSL.g4:5-18; csl.ecore Object/Role/OrgCtx; AuctionArtifact.java:13,18-23&quot;]], &quot;istar_state_mapping&quot;: [[&quot;Create &amp; focus artifact&quot;, &quot;step.enabled / step.succeeded&quot;, &quot;Auction existence and immutable id; focus is runtime observer data&quot;, &quot;PARTIAL: domain existence only&quot;], [&quot;Call start(Service)&quot;, &quot;Idle / Opened&quot;, &quot;Auction.running, Auction.task; service is invocation input&quot;, &quot;DOMAIN STATE COVERED; operation supplied by execution adapter&quot;], [&quot;Query focused artifact&quot;, &quot;step.enabled / step.succeeded&quot;, &quot;Auction.id supports identity; agent-artifact focus is not a passive domain relation&quot;, &quot;PARTIAL: observer required&quot;], [&quot;Call stop()&quot;, &quot;RunningForStop / Closed&quot;, &quot;Auction.running; source winner publication also uses currentWinner/winner&quot;, &quot;DOMAIN STATE COVERED; existing OCL post only checks running=false&quot;], [&quot;Find &amp; focus artifact&quot;, &quot;step.enabled / step.succeeded&quot;, &quot;Auction existence/id; runtime focus relation&quot;, &quot;PARTIAL: observer required&quot;], [&quot;Wait, then bid(amount)&quot;, &quot;RunningForBid / step.succeeded&quot;, &quot;Auction.running; amount is input; best_bid/currentWinner only change on improvement&quot;, &quot;PARTIAL: successful non-improving bid cannot be inferred from a snapshot&quot;], [&quot;Auctioneer.start&quot;, &quot;AND(Create &amp; focus, Call start)&quot;, &quot;Auction existence/id, running/task; observed focus and step success&quot;, &quot;CSL domain + external evidence&quot;], [&quot;Auctioneer.decide&quot;, &quot;AND(Query focus, Call stop)&quot;, &quot;Auction.id/running/winner/currentWinner; focus and stop invocation&quot;, &quot;CSL domain + external evidence&quot;], [&quot;Participant.bid&quot;, &quot;AND(Find &amp; focus, Wait then bid)&quot;, &quot;Auction.id/running; per-player successful bid event&quot;, &quot;CSL domain + external evidence; no persistent Bid&quot;], [&quot;Auction.start&quot;, &quot;Dependency via D_start to Auctioneer.start&quot;, &quot;Mapped Role/Task evaluation&quot;, &quot;iStar propagation; no CSL Goal flag&quot;], [&quot;Auction.decide&quot;, &quot;Dependency via D_decide to Auctioneer.decide&quot;, &quot;Mapped Role/Task evaluation&quot;, &quot;iStar propagation; no CSL Goal flag&quot;], [&quot;Auction.bid&quot;, &quot;Dependency via D_bid to Participant.bid&quot;, &quot;All relevant committed enactments; not all group role players&quot;, &quot;iStar propagation + explicit per-agent binding; observer needed&quot;], [&quot;Auction.auction&quot;, &quot;AND(start,bid,decide), Achieve&quot;, &quot;Mapped and evaluated children per auction Id&quot;, &quot;iStar layer; no CSL root-goal attribute&quot;], [&quot;D_start&quot;, &quot;Goal dependum of start Dependency&quot;, &quot;Auctioneer.start evaluation&quot;, &quot;iStar element only&quot;], [&quot;D_decide&quot;, &quot;Goal dependum of decide Dependency&quot;, &quot;Auctioneer.decide evaluation&quot;, &quot;iStar element only&quot;], [&quot;D_bid&quot;, &quot;Goal dependum of bid Dependency&quot;, &quot;Participant.bid evaluation per committed enactment&quot;, &quot;iStar element only; administrative satisfaction is separate&quot;]], &quot;ocl_audit&quot;: [[&quot;Auction::start(service:String)&quot;, &quot;running:Boolean, task:String&quot;, &quot;COVERED state; operation contexts outside CSL core&quot;], [&quot;Auction::bid(amount:Real)&quot;, &quot;running:Boolean&quot;, &quot;COVERED guard; no bid object/history promised&quot;], [&quot;Auction::stop()&quot;, &quot;running:Boolean&quot;, &quot;COVERED guard/post; no precondition referring to MOISE added&quot;], [&quot;AuctionMonitor::SchemeOrder&quot;, &quot;five enabled/satisfied Integer timestamps&quot;, &quot;EXTERNAL OBSERVER; no such CSL class&quot;], [&quot;AuctionMonitor::BidEvidence&quot;, &quot;actualBidBy/bidDoneBy/bidCommittedBy:Set(String); adminBidOverride:Boolean&quot;, &quot;EXTERNAL OBSERVER; participant role population is not mission commitment&quot;], [&quot;AuctionObligation::WithinDeadline&quot;, &quot;goal, activatedAt, deadlineAt, endedAt, unfulfilled, monitor.now&quot;, &quot;EXTERNAL DEONTIC TRACE; monitor navigation is not a CSL association&quot;], [&quot;@pre&quot;, &quot;No @pre expression exists in the supplied final OCL&quot;, &quot;No historical snapshot property is invented in CSL&quot;]], &quot;limitations&quot;: [&quot;Core v4 parsing/validation is supported; CslModel.requireLegacyRuntime rejects legacy execution/CSL-to-USE translation.&quot;, &quot;The supplied .ocl is not directly compilable against CSL alone: operation signatures and observer classes are external.&quot;, &quot;Drawio is editable model documentation, not an executable .csl/.use input. Its validated CSL source is embedded as cslSource metadata.&quot;, &quot;AuctionOrg is organizational scope, not a CArtAgO workspace. Source artifact names id a1/a2 correlate scheme argument Id to domain objects.&quot;, &quot;currentWinner is source-backed internal state, not an observable property; extraction needs explicit privileged access or instrumentation.&quot;, &quot;Double.MAX_VALUE must be preserved or explicitly abstracted for a finite model; never silently replace it by zero/infinity.&quot;, &quot;iStar Auction is an organization-level viewpoint; a total actor-to-CSL-Role correspondence under paper Definition 4(iii) is not supplied by the current model set. Do not invent a coordinator Role to force it.&quot;, &quot;Mapping source task self to Auction Entity needs explicit invocation/Id binding; it is not the same as the paper global self=c:OrgCtx convention.&quot;], &quot;verification&quot;: {&quot;csl&quot;: &quot;v4 parser, semantic validator, roundtrip passed&quot;, &quot;use&quot;: &quot;USE 7.1.1 temporary explicit state projection: 5 classes, 2 population invariants, 5 operation clauses, 16 checks passed&quot;, &quot;backend&quot;: &quot;Verified v4 legacy-runtime rejection; no live JaCaMo verification claim&quot;}}">

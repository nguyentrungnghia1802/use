-- Domain projection of the original Auction declarations and direct role links.
-- Load after importing Auction. DEMO_FAIL is deliberately false.
context Agent
inv PASS_AuctionHasFiveAgents: Agent.allInstances()->size() = 5
inv PASS_ProgramIdentity: not self.semanticId.oclIsUndefined()
inv DEMO_FAIL_AuctionShouldHaveSixAgents: Agent.allInstances()->size() = 6

context auction_Organization
inv PASS_OneOrganisation: auction_Organization.allInstances()->size() = 1

context auctionGroup
inv PASS_OneGroup: auctionGroup.allInstances()->size() = 1

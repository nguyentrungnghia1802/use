<?xml version="1.0" ?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <id>release</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <fileSets>
        <fileSet>
            <directory>${project.build.directory}/jacamo-runtime</directory>
            <outputDirectory>bridge/state</outputDirectory>
            <includes>
                <include>*.jar</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>src/main/resources/example</directory>
            <outputDirectory>examples</outputDirectory>
        </fileSet>
        <fileSet>
            <directory>../doc</directory>
            <outputDirectory>doc</outputDirectory>
            <includes>
                <include>*.md</include>
            </includes>
        </fileSet>
    </fileSets>
    <files>
        <file>
            <source>${project.build.directory}/use-jacamo-plugin-1.0.1.jar</source>
            <outputDirectory>lib/plugins</outputDirectory>
            <destName>use-jacamo-plugin-1.0.1.jar</destName>
        </file>
        <file>
            <source>${project.build.directory}/use-jacamo-plugin-1.0.1-csl.jar</source>
            <outputDirectory>lib/plugins</outputDirectory>
            <destName>use-csl-model-1.0.1.jar</destName>
        </file>
        <file>
            <source>${project.build.directory}/use-jacamo-plugin-1.0.1-oal.jar</source>
            <outputDirectory>lib/plugins</outputDirectory>
            <destName>use-oal-model-1.0.1.jar</destName>
        </file>
        <file>
            <source>${project.build.directory}/use-jacamo-plugin-1.0.1-istar.jar</source>
            <outputDirectory>lib/plugins</outputDirectory>
            <destName>use-istar-model-1.0.1.jar</destName>
        </file>
        <file>
            <source>${project.build.directory}/use-jacamo-plugin-1.0.1-istarscn.jar</source>
            <outputDirectory>lib/plugins</outputDirectory>
            <destName>use-istar-scn-1.0.1.jar</destName>
        </file>
        <file>
            <source>${project.build.directory}/use-jacamo-plugin-1.0.1.jar</source>
            <outputDirectory>bridge/state</outputDirectory>
        </file>
    </files>
</assembly>

                icon="icons/status.gif" tooltip="Import official JaCaMo Bridge snapshots and verify them in USE"
                menu="JaCaMo" menuitem="Open Workbench..." toolbaritem="false"/>
        <action id="org.tzi.use.plugins.jacamo.status.action" label="JaCaMo status"
                class="org.tzi.use.plugins.jacamo.JaCaMoStatusAction"
                icon="icons/status.gif" tooltip="Show JaCaMo Bridge authority and readiness status"

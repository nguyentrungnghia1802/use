<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.tzi.use</groupId>
        <artifactId>use</artifactId>
        <version>7.5.0</version>
    </parent>
    <artifactId>use-plugin</artifactId>
    <version>1.0.1</version>
    <name>USE CSL, OAL, iStar and JaCaMo plugins</name>
    <properties>
        <antlr4.version>4.9.3</antlr4.version>
    </properties>
    <repositories>
        <repository>
            <id>jacamo</id>
            <url>https://raw.githubusercontent.com/jacamo-lang/mvn-repo/master</url>
        </repository>
    </repositories>
    <dependencies>
        <dependency>
            <groupId>org.tzi.use</groupId>
            <artifactId>use-gui</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.tzi.use</groupId>
            <artifactId>use-core</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jacamo</groupId>
            <artifactId>jacamo</artifactId>
            <version>1.3.1-checkpoint-SNAPSHOT</version>
            <exclusions>
                <exclusion>
                    <groupId>org.gradle</groupId>
                    <artifactId>gradle-tooling-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
            <version>${antlr4.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.8.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4</artifactId>
            <version>${antlr4.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>use-jacamo-plugin-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <version>${antlr4.version}</version>
                <executions>
                    <execution>
                        <id>language-parsers</id>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>${project.basedir}/src/main/resources/grammars</sourceDirectory>
                            <includes>
                                <include>CSL.g4</include>
                                <include>IStar.g4</include>
                            </includes>
                            <visitor>true</visitor>
                            <listener>true</listener>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <forceCreation>true</forceCreation>
                    <excludes>
                        <exclude>plugins/**</exclude>
                    </excludes>
                    <archive>
                        <manifest>
                            <mainClass>org.tzi.use.plugins.jacamo.JaCaMoPlugin</mainClass>
                        </manifest>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>csl-entry-point</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>csl</classifier>
                            <classesDirectory>${project.build.outputDirectory}/plugins/csl-model</classesDirectory>
                            <archive>
                                <manifest>
                                    <mainClass>org.tzi.use.plugins.jacamo.feature.csl.CslModelPlugin</mainClass>
                                </manifest>
                                <manifestEntries>
                                    <Class-Path>use-jacamo-plugin-${project.version}.jar</Class-Path>
                                </manifestEntries>
                            </archive>
                        </configuration>
                    </execution>
                    <execution>
                        <id>oal-entry-point</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>oal</classifier>
                            <classesDirectory>${project.build.outputDirectory}/plugins/oal-model</classesDirectory>
                            <archive>
                                <manifest>
                                    <mainClass>org.tzi.use.plugins.jacamo.feature.oal.OalModelPlugin</mainClass>
                                </manifest>
                                <manifestEntries>
                                    <Class-Path>use-jacamo-plugin-${project.version}.jar</Class-Path>
                                </manifestEntries>
                            </archive>
                        </configuration>
                    </execution>
                    <execution>
                        <id>istar-entry-point</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>istar</classifier>
                            <classesDirectory>${project.build.outputDirectory}/plugins/istar-model</classesDirectory>
                            <archive>
                                <manifest>
                                    <mainClass>org.tzi.use.plugins.jacamo.feature.istar.IStarModelPlugin</mainClass>
                                </manifest>
                                <manifestEntries>
                                    <Class-Path>use-jacamo-plugin-${project.version}.jar</Class-Path>
                                </manifestEntries>
                            </archive>
                        </configuration>
                    </execution>
                    <execution>
                        <id>istarscn-entry-point</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>istarscn</classifier>
                            <classesDirectory>${project.build.outputDirectory}/plugins/istar-scn</classesDirectory>
                            <archive>
                                <manifest>
                                    <mainClass>org.tzi.use.plugins.jacamo.feature.istarscn.IStarScnPlugin</mainClass>
                                </manifest>
                                <manifestEntries>
                                    <Class-Path>use-jacamo-plugin-${project.version}.jar</Class-Path>
                                </manifestEntries>
                            </archive>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Only the parser runtime is shaded. USE and JaCaMo retain their own implementations. -->
            <plugin>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>plugin-runtime</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>org.antlr:antlr4-runtime</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.tzi.use.plugins.jacamo.JaCaMoPlugin</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>development-runtime-classpath</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputFile>${project.build.directory}/runtime-classpath.txt</outputFile>
                            <regenerateFile>true</regenerateFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>official-jacamo-runtime</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <excludeArtifactIds>antlr4-runtime</excludeArtifactIds>
                            <outputDirectory>${project.build.directory}/jacamo-runtime</outputDirectory>
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>plugins-distribution</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/plugins.xml</descriptor>
                            </descriptors>
                            <finalName>use-modeling-tools-${project.version}</finalName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.tzi.use</groupId>
        <artifactId>use</artifactId>
        <version>7.5.0</version>
    </parent>
    <artifactId>use-plugin</artifactId>
    <version>1.0.1</version>
    <name>USE JaCaMo Plugin</name>

    <properties>
        <project.build.outputTimestamp>2026-09-18T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <repositories>
        <repository>
            <id>jacamo</id>
            <url>https://raw.githubusercontent.com/jacamo-lang/mvn-repo/master</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Native Ecore audit only; not a production or packaged runtime dependency. -->
        <dependency>
            <groupId>org.eclipse.emf</groupId>
            <artifactId>org.eclipse.emf.ecore.xmi</artifactId>
            <version>2.39.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>2.0.1</version>
        </dependency>
        <dependency>
            <groupId>org.tzi.use</groupId>
            <artifactId>use-gui</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.github.jason-lang</groupId>
            <artifactId>jason-interpreter</artifactId>
            <version>3.3.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jacamo</groupId>
            <artifactId>cartago</artifactId>
            <version>3.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jacamo</groupId>
            <artifactId>moise</artifactId>
            <version>1.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.8.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>Core/Metamodel/version-1</directory>
                <targetPath>org/tzi/use/plugins/jacamo/historical/version-1</targetPath>
                <includes><include>JaCaMo-Metamodel.ecore</include></includes>
            </resource>
            <resource>
                <directory>Core/Mapping/version-1</directory>
                <targetPath>org/tzi/use/plugins/jacamo/historical/version-1</targetPath>
                <includes>
                    <include>jacamo-use-mapping-v1.json</include>
                    <include>jacamo-use-mapping.schema.json</include>
                    <include>freeze-manifest.json</include>
                </includes>
            </resource>
            <resource>
                <directory>Core/Metamodel/version-2</directory>
                <targetPath>org/tzi/use/plugins/jacamo/canonical/version-2</targetPath>
                <includes><include>jacamo_v2_complete.ecore</include></includes>
            </resource>
            <resource>
                <directory>Core/Mapping/version-2</directory>
                <targetPath>org/tzi/use/plugins/jacamo/canonical/version-2</targetPath>
                <includes><include>jacamo-use-mapping-v2.json</include><include>jacamo-use-mapping-v2.schema.json</include></includes>
            </resource>
            <resource>
                <directory>release</directory>
                <targetPath>org/tzi/use/plugins/jacamo/release</targetPath>
                <includes><include>release-manifest.json</include></includes>
            </resource>
            <resource>
                <directory>.</directory>
                <targetPath>org/tzi/use/plugins/jacamo/release</targetPath>
                <includes><include>compatibility.json</include></includes>
            </resource>
            <resource>
                <directory>licenses</directory>
                <targetPath>org/tzi/use/plugins/jacamo/release/licenses</targetPath>
                <includes>
                    <include>APACHE-2.0.txt</include>
                    <include>SLF4J-MIT.txt</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <forceCreation>true</forceCreation>
                    <archive>
                        <manifest>
                            <mainClass>org.tzi.use.plugins.jacamo.JaCaMoPlugin</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.tzi.use.plugins.jacamo.JaCaMoPlugin</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>release-package</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <descriptors><descriptor>src/assembly/release.xml</descriptor></descriptors>
                            <finalName>use-jacamo-plugin-${project.version}-v2-working</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>release-package-checksum</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <checksum file="${project.build.directory}/use-jacamo-plugin-${project.version}-v2-working.zip"
                                          algorithm="SHA-256" fileext=".sha256" format="MD5SUM"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.2.5</version>
                <executions>
                    <execution>
                        <goals><goal>integration-test</goal><goal>verify</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

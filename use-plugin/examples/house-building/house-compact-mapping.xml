<?xml version="1.0" encoding="utf-8"?>
<mapping id="house-building-compact" xmlns="urn:use:jacamo-mapping:3" version="3.0">
  <csl>
    <map source="workspace:*" target="BuildingRun"/>
    <map source="workspace:*/identity:path" target="BuildingRun.workspace"/>
    <map source="artifact:tools.AuctionArt" target="ProcurementAuction"/>
    <map source="artifact:tools.AuctionArt/identity:name" target="ProcurementAuction.name"/>
    <map source="artifact:tools.AuctionArt/identity:workspace" target="ProcurementAuction.workspace"/>
    <map source="artifact:tools.AuctionArt/property:task" target="ProcurementAuction.task" policy="OBSERVED_PROPERTY/1.0"/>
    <map source="artifact:tools.AuctionArt/property:maxValue" target="ProcurementAuction.maxValue" policy="OBSERVED_PROPERTY/1.0"/>
    <map source="artifact:tools.AuctionArt/property:currentBid" target="ProcurementAuction.currentBid" policy="OBSERVED_PROPERTY/1.0" converter="JAVA_SCALAR_NUMBER_TO_REAL/1.0"/>
    <map source="artifact:tools.AuctionArt/property:currentWinner" target="ProcurementAuction.currentWinner" policy="OBSERVED_PROPERTY/1.0"/>
  </csl>
  <istar>
    <map source="workspace:*" target="ConstructionObserver"/>
  </istar>
  <runtime>
    <actorRuntime actor="ConstructionObserver" activationPolicy="PROJECT_EXECUTION_VIEW" episodePolicy="STATIC_LIFETIME" self="BuildingRun"/>
    <verify target="ConstructionObserver.HouseRealized" scope="workspace:*"/>
    <milestones kind="DOMAIN"/>
  </runtime>
  <observers>
    <view id="build-progress" name="BuildProgress" category="CLASS" keyFields="uuid" source="artifact:simulator.House">
      <field name="workspace" type="String" origin="WORKSPACE_PATH/1.0"/>
      <field name="prepareSiteAt" type="Integer" origin="CARTAGO_FIRST_SUCCESS_SEQUENCE/1.0:prepareSite"/>
      <field name="layFloorsAt" type="Integer" origin="CARTAGO_FIRST_SUCCESS_SEQUENCE/1.0:layFloors"/>
      <field name="buildWallsAt" type="Integer" origin="CARTAGO_FIRST_SUCCESS_SEQUENCE/1.0:buildWalls"/>
      <field name="buildRoofAt" type="Integer" origin="CARTAGO_FIRST_SUCCESS_SEQUENCE/1.0:buildRoof"/>
      <field name="fitWindowsAt" type="Integer" origin="CARTAGO_FIRST_SUCCESS_SEQUENCE/1.0:fitWindows"/>
      <field name="fitDoorsAt" type="Integer" origin="CARTAGO_FIRST_SUCCESS_SEQUENCE/1.0:fitDoors"/>
      <field name="installPlumbingAt" type="Integer" origin="CARTAGO_FIRST_SUCCESS_SEQUENCE/1.0:installPlumbing"/>
      <field name="installElectricalSystemAt" type="Integer" origin="CARTAGO_FIRST_SUCCESS_SEQUENCE/1.0:installElectricalSystem"/>
      <field name="paintExteriorAt" type="Integer" origin="CARTAGO_FIRST_SUCCESS_SEQUENCE/1.0:paintExterior"/>
      <field name="paintInteriorAt" type="Integer" origin="CARTAGO_FIRST_SUCCESS_SEQUENCE/1.0:paintInterior"/>
    </view>
  </observers>
</mapping>

<?xml version="1.0" encoding="utf-8"?>
<mapping id="auction-compact" xmlns="urn:use:jacamo-mapping:3" version="3.0">
  <csl>
    <map source="artifact:auction_env.AuctionArtifact" target="Auction"/>
    <map source="artifact:auction_env.AuctionArtifact/property:winner" target="Auction.winner"/>
    <map source="artifact:auction_env.AuctionArtifact/field:currentWinner" target="Auction.currentWinner"/>
    <map source="artifact:auction_env.AuctionArtifact/property:task" target="Auction.task"/>
    <map source="artifact:auction_env.AuctionArtifact/property:running" target="Auction.running"/>
    <map source="artifact:auction_env.AuctionArtifact/property:best_bid" target="Auction.best_bid"/>
    <map source="moise:auction/group:auctionGroup" target="auctionGroup"/>
    <map source="moise:auction/role:auctioneer" target="auctioneer"/>
    <map source="moise:auction/role:participant" target="participant"/>
  </csl>
  <istar>
    <map source="agent:auction_capabilities" target="auction_capabilities"/>
    <map source="asl:src/agt/auction_capabilities.asl/goal:do_auction" target="auction_capabilities.do_auction"/>
    <map source="asl:src/agt/auction_capabilities.asl/plan:do_auction(Id,P)/step:createScheme[0..3]" target="auction_capabilities.createScheme"/>
    <map source="asl:src/agt/auction_capabilities.asl/plan:do_auction(Id,P)/step:commitMission[3..10]" target="auction_capabilities.commitMission"/>
    <map source="moise:auction/role:auctioneer" target="Auctioneer"/>
    <map source="moise:auction/role:participant" target="Participant"/>
  </istar>
  <runtime>
    <actorRuntime actor="auction_capabilities" activationPolicy="MODEL_ONLY_CAPABILITY_ROLE" episodePolicy="MODEL_REVISION"/>
    <actorRuntime actor="Auctioneer" activationPolicy="EXPLICIT_ENACTMENT" episodePolicy="STATIC_LIFETIME"/>
    <actorRuntime actor="Participant" activationPolicy="EXPLICIT_ENACTMENT" episodePolicy="STATIC_LIFETIME"/>
    <requirement id="cartago.artifact-field.v1" provider="cartago"/>
    <requirement id="jason.plan-boundaries.v1" provider="jason"/>
    <requirement id="moise.scheme-lifecycle.v1" provider="moise"/>
    <milestones kind="DOMAIN"/>
  </runtime>
</mapping>


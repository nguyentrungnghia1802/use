// Auction iStar system specification. Based on Desktop
// auction_istar_final_fixed.drawio, including Artifact Resources.
// Actor kinds and graph follow the supplied Draw.io, including its capability Role.
// The XML explicitly binds repeated views of the SAME source Goal to the SAME
// physical player and scheme. Native refinement checks the real Task evidence.
// These view correspondences are not additional social Dependencies.
// Actor Auction is a context viewpoint, not a running agent.
// The seven Tasks and dependency endpoints follow the authoritative Core diagram.
// P_bid_t2 requires source success; the .fail branch is not an achievement.
// D_bid means at least one assigned participant successfully performs its bid.
// Agent/program source, mission commitments, action receipts and self identity
// are connected by XML, never inferred from names or console Winner messages.
istar AuctionGoals {
    agent Auction {
        goal O_root : Achieve
        goal O_start : Achieve > O_root
        goal O_bid : Achieve > O_root
        goal O_decide : Achieve > O_root
    }
    // Shared program/capability viewpoint, as declared by the diagram's Role node.
    // A physical-player view is not another MOISE Role enactment.
    role auction_capabilities {
        auction_capabilities participates-in Auctioneer
        auction_capabilities participates-in Participant
        goal do_auction : Achieve
        task createScheme > do_auction
            pre {[ step.enabled ]}
            post {[ step.succeeded ]}
        task commitMission > do_auction
            pre {[ step.enabled ]}
            post {[ step.succeeded ]}
        goal C_start : Achieve
        task A_start_t1 > C_start
            pre {[ step.enabled ]}
            post {[ step.succeeded ]}
        task A_start_t2 > C_start
            pre {[ not self.running ]}
            post {[ self.running and self.task = service ]}
        goal C_decide : Achieve
        task A_decide_t2 > C_decide
            pre {[ self.running ]}
            post {[ not self.running ]}
        goal C_bid : Achieve
        task P_bid_t1 > C_bid
            pre {[ step.enabled ]}
            post {[ step.succeeded ]}
        task P_bid_t2 > C_bid
            pre {[ step.enabled and self.running ]}
            post {[ step.succeeded ]}
        resource SchemeBoard > needed-by commitMission > needed-by A_start_t1
        resource AuctionArtifact > needed-by A_start_t2 > needed-by A_decide_t2 > needed-by P_bid_t2
    }
    role Auctioneer {
        goal A_start : Achieve
        goal A_decide : Achieve
    }
    role Participant {
        goal P_bid : Achieve
    }
    depend Auction.O_start -> goal D_start -> Auctioneer.A_start
    depend Auction.O_decide -> goal D_decide -> Auctioneer.A_decide
    depend Auction.O_bid -> goal D_bid -> Participant.P_bid
}

// Behavioral observer contracts audit source-confirmed ordering/evidence.
// They are not CSL Entities, nor definitions of Goal satisfaction.
// MOISE public goal-state transition times use the source logical clock.
// Their provenance is publication; private internal truth-change instants are not claimed.
/* @use-native-ocl 1
context AuctionMonitor
inv SchemeOrder:
    (self.bidEnabledAt >= 0 implies
        self.startSatisfiedAt >= 0 and
        self.startSatisfiedAt <= self.bidEnabledAt) and
    (self.bidSatisfiedAt >= 0 implies
        self.bidEnabledAt >= 0 and
        self.bidEnabledAt <= self.bidSatisfiedAt) and
    (self.decideEnabledAt >= 0 implies
        self.bidSatisfiedAt >= 0 and
        self.bidSatisfiedAt <= self.decideEnabledAt) and
    (self.decideSatisfiedAt >= 0 implies
        self.decideEnabledAt >= 0 and
        self.decideEnabledAt <= self.decideSatisfiedAt)

-- Keep latest Desktop EXISTS semantics: at least one committed participant
-- has both observed MOISE done evidence and a successful real bid, unless the
-- exact successful administrative override is observed. The override permits
-- scheme progress; it does not satisfy D_bid or count as an actual bid.
-- Role population is not mission commitment. Freeze bidCommittedBy at the first
-- observed bid satisfaction; keep exact same-run/same-scheme player identities.
context AuctionMonitor
inv BidEvidence:
    self.bidDoneBy->forAll(a |
        self.actualBidBy->includes(a)) and
    (self.bidSatisfiedAt >= 0 implies
        self.adminBidOverride or
        self.bidCommittedBy->exists(a |
            self.bidDoneBy->includes(a) and
            self.actualBidBy->includes(a)))
*/

// The diagram keeps the normative deadline requirement. This executable example
// temporarily disables that assertion by explicit user choice; native NPL timers
// and Task/Goal execution checks remain active.
/* Temporarily disabled by the user on 2026-11-05.
The preserved body below is not an active native OCL annotation.

inv WithinDeadline:
    self.deadlineAt =
        self.activatedAt +
        (if self.goal = 'bid' then 10000 else 3600000 endif)
    and not self.unfulfilled
    and
        (if self.endedAt >= 0
         then self.endedAt
         else self.monitor.now
         endif) <= self.deadlineAt
*/

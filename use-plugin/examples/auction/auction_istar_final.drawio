        <mxCell id="O_semantics_text" parent="O_boundary" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#15202B;fontSize=16;align=left;verticalAlign=top;" value="&lt;b&gt;Normative dependency&lt;/b&gt;&lt;br&gt;&lt;br&gt;Auction relies on the assigned&lt;br&gt;roles to fulfil the three goals.&lt;br&gt;Participant means every relevant&lt;br&gt;committed role enactment." vertex="1">

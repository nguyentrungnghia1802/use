          <mxGeometry x="0" y="0" width="24" height="28" relative="1" as="geometry">
            <mxPoint x="-12" y="-14" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dep_start_b" edge="1" parent="1" source="D_start" target="A_start" value="" relation="dependencyLeg" dependencyId="dep_start" style="edgeStyle=none;html=1;strokeColor=#15202B;strokeWidth=1.6;startArrow=none;endArrow=none;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">

        </mxCell>
        <mxCell id="D_decide" parent="1" vertex="1" value="&lt;b&gt;Auction closed;&lt;br&gt;result available&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;strokeWidth=1.6;strokeColor=#15202B;fillColor=#FFFFFF;fontFamily=Arial;fontSize=16;spacing=7;" elementType="dependum" dependumType="goal" dependencyId="dep_decide" depender="Auction" dependee="Auctioneer" sourceReference="auction-os.xml:38-41,49; auction_capabilities.asl:27-30" scope="normative-realization">
          <mxGeometry x="770" y="865" width="200" height="95" as="geometry" />
        </mxCell>
        <mxCell id="dep_decide_a" edge="1" parent="1" source="O_decide" target="D_decide" value="" relation="dependencyLeg" dependencyId="dep_decide" style="edgeStyle=none;html=1;strokeColor=#15202B;strokeWidth=1.6;startArrow=none;endArrow=none;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">

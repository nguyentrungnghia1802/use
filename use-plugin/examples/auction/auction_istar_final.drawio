          </mxGeometry>
        </mxCell>
        <mxCell id="A_query_note" value="The decide plan queries an existing focus; it does not call focus again." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#15202B;fontSize=14;" vertex="1" parent="A_boundary">
          <mxGeometry x="35" y="947" width="580" height="30" as="geometry" />
        </mxCell>
        <mxCell id="P_branch_note" value="&lt;b&gt;Jason failure and recovery&lt;/b&gt;&lt;br&gt;&lt;br&gt;The successful branch waits 500..2500 ms, then calls&lt;br&gt;bid(random * 100 + 10). The other branch calls .fail.&lt;br&gt;&lt;br&gt;A failed !bid plan produces no normal goalAchieved.&lt;br&gt;An unfulfilled bid obligation triggers the Auctioneer's&lt;br&gt;administrative handler.&lt;br&gt;&lt;br&gt;Failure and administrative recovery are not OR means&lt;br&gt;to perform an actual bid. A non-winning successful&lt;br&gt;bid still counts as an actual bid." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#15202B;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="P_boundary">
          <mxGeometry x="35" y="640" width="580" height="310" as="geometry" />
        </mxCell>
        <mxCell id="O_admin_note" parent="O_boundary" vertex="1" value="&lt;b&gt;Administrative status&lt;/b&gt;&lt;br&gt;&lt;br&gt;goalSatisfied(bid) can let the&lt;br&gt;scheme proceed despite failure.&lt;br&gt;This does not fulfil the actual-bid&lt;br&gt;dependency or prove root success." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#15202B;fontSize=16;align=left;verticalAlign=top;">
          <mxGeometry x="400" y="550" width="280" height="180" as="geometry" />
        </mxCell>
        <mxCell id="D_start" parent="1" vertex="1" value="&lt;b&gt;Auction started&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;strokeWidth=1.6;strokeColor=#15202B;fillColor=#FFFFFF;fontFamily=Arial;fontSize=16;spacing=7;" elementType="dependum" dependumType="goal" dependencyId="dep_start" depender="Auction" dependee="Auctioneer" sourceReference="auction-os.xml:38-41,49; auction_capabilities.asl:19-25" scope="normative-realization">
          <mxGeometry x="770" y="385" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dep_start_a" edge="1" parent="1" source="O_start" target="D_start" value="" relation="dependencyLeg" dependencyId="dep_start" style="edgeStyle=none;html=1;strokeColor=#15202B;strokeWidth=1.6;startArrow=none;endArrow=none;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

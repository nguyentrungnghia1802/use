        <mxCell id="D_bid" parent="1" vertex="1" value="&lt;b&gt;Assigned bid&lt;br&gt;performed&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;strokeWidth=1.6;strokeColor=#15202B;fillColor=#FFFFFF;fontFamily=Arial;fontSize=16;spacing=7;" elementType="dependum" dependumType="goal" dependencyId="dep_bid" depender="Auction" dependee="Participant" sourceReference="auction-os.xml:42-44,50; auction_capabilities.asl:32-42" scope="per-committed-role-enactment">

        <mxCell id="legend" parent="1" style="rounded=0;html=1;whiteSpace=wrap;strokeWidth=1.2;strokeColor=#ADB8C3;fillColor=#F8FAFC;fontFamily=Arial;fontColor=#15202B;" value="" vertex="1">

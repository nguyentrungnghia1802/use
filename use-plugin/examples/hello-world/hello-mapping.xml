  <istar name="HelloWorldRequirements" />
  <runtime>
    <datasets>
      <facts id="raw-operations" authority="cartago" kind="OPERATION" />
      <facts id="raw-artifacts" authority="cartago" kind="ARTIFACT" />
      <facts id="raw-properties" authority="cartago" kind="PROPERTY" />
      <facts id="raw-workspaces" authority="cartago" kind="WORKSPACE" />
    </datasets>
    <tables>
      <table id="all-workspaces" dataset="raw-workspaces">
        <column name="uuid" path="identity" required="true" />
        <column name="workspace" path="values.semanticId" required="true" />
      </table>
      <table id="selected-workspaces" dataset="raw-workspaces">
        <where path="values.name" type="String" equals="jacamo" />
        <column name="uuid" path="identity" required="true" />
        <column name="workspace" path="values.semanticId" required="true" />
        <identity mode="PHYSICAL" path="identity" />
      </table>
      <table id="property-numMsg" dataset="raw-properties">
        <where path="values.name" type="String" equals="numMsg" />
        <column name="artifact" path="values.artifactSemanticId" required="true" />
        <column name="value" path="scalar.value" required="true" />
      </table>
      <table id="selected-artifacts" dataset="raw-artifacts">
        <where path="values.artifactTypeJavaClassName" type="String" equals="display.GUIConsole" />
        <join tableRef="all-workspaces" leftPath="values.workspaceSemanticId" rightPath="workspace" as="w" cardinality="ONE" required="true" />
        <join tableRef="property-numMsg" leftPath="values.semanticId" rightPath="artifact" as="pnumMsg" cardinality="ONE" required="true" />
        <column name="uuid" path="identity" required="true" />
        <column name="name" path="values.name" required="true" />
        <column name="workspace" path="w.workspace" required="true" />
        <column name="numMsg" path="pnumMsg.value" required="true" />
        <identity mode="PHYSICAL" path="identity" />
      </table>
    </tables>
    <inputs>
      <input id="context-input" identityKind="PHYSICAL" identityFields="uuid" tableRef="selected-workspaces">
        <field name="uuid" type="String" required="true" />
        <field name="workspace" type="String" required="true" />
      </input>
      <input id="artifact-input" identityKind="PHYSICAL" identityFields="uuid" tableRef="selected-artifacts">
        <field name="uuid" type="String" required="true" />
        <field name="name" type="String" required="true" />
        <field name="workspace" type="String" required="true" />
        <field name="numMsg" type="Integer" required="true" />
      </input>
    </inputs>
    <converters>
      <converter id="string" inputType="String" outputType="String" algorithm="preserve-exact-content" onMismatch="incomplete" />
      <converter id="integer" inputType="Integer" outputType="Integer" algorithm="preserve-exact-integer" onMismatch="incomplete" />
    </converters>
    <rule id="map-context" inputRef="context-input">
      <requireEvidence proof="source-cut" />
      <upsertInstance targetType="GreetingRun" keyFields="uuid" aliasFrom="uuid">
        <assign target="workspace" sourceField="workspace" converter="string" />
      </upsertInstance>
    </rule>
    <rule id="map-artifact" inputRef="artifact-input">
      <requireEvidence proof="source-cut" />
      <upsertInstance targetType="Console" keyFields="uuid" aliasFrom="uuid">
        <assign target="name" sourceField="name" converter="string" />
        <assign target="workspace" sourceField="workspace" converter="string" />
        <assign target="numMsg" sourceField="numMsg" converter="integer" />
      </upsertInstance>
    </rule>
    <occurrences>
      <scope id="observed-run" tableRef="selected-workspaces" anchorColumn="uuid" contextColumn="uuid" keyFields="uuid">
        <actor actor="GreetingObserver" tableRef="selected-workspaces" scopeColumn="uuid" scopeKey="uuid" playerColumn="uuid" kind="CONTEXT_VIEWPOINT" cardinality="ONE" />
        <self target="TwelveMessagesObserved" origin="CONTEXT" />
        <self target="NonnegativeCounts" origin="CONTEXT" />
      </scope>
    </occurrences>
  </runtime>
  <observers />
  <bindings>
    <static id="bind-context" kind="ORG_CONTEXT" target="GreetingRun" sourceKind="JACAMO_PROJECT" feature="name" value="helloworld" reason="Authored physical workspace viewpoint; not a second organization or running agent">

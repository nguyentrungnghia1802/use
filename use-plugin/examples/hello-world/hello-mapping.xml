    <static id="bind-actor" kind="ACTOR" target="GreetingObserver" sourceKind="JACAMO_PROJECT" feature="name" value="helloworld" reason="Collective observation viewpoint; never credits an operation to an individual agent" />
    <actorRuntime actor="GreetingObserver" bindingRef="bind-actor" contextBindingRef="bind-context" activationPolicy="OBSERVED_SCHEME_COMMITMENT" episodePolicy="RUN_SCHEME_PLAYER_INVOCATION" />
    <elementRuntime target="TwelveMessagesObserved" actor="GreetingObserver" self="GreetingRun" derived="false" selfKind="CONTEXT" reason="Authored outcome condition on accepted state; not a raw active Jason goal" />
    <elementRuntime target="NonnegativeCounts" actor="GreetingObserver" self="GreetingRun" derived="false" selfKind="CONTEXT" reason="Authored outcome condition on accepted state; not a raw active Jason goal" />

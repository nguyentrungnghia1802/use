<?xml version="1.0" encoding="utf-8"?>
<mapping id="hello-world-compact" xmlns="urn:use:jacamo-mapping:3" version="3.0">
  <csl>
    <map source="workspace:*" target="GreetingRun"/>
    <map source="workspace:*/identity:path" target="GreetingRun.workspace"/>
    <map source="artifact:display.GUIConsole" target="Console"/>
    <map source="artifact:display.GUIConsole/identity:name" target="Console.name"/>
    <map source="artifact:display.GUIConsole/identity:workspace" target="Console.workspace"/>
    <map source="artifact:display.GUIConsole/property:numMsg" target="Console.numMsg" policy="OBSERVED_PROPERTY/1.0"/>
  </csl>
  <istar>
    <map source="workspace:*" target="GreetingObserver"/>
  </istar>
  <runtime>
    <actorRuntime actor="GreetingObserver" activationPolicy="PROJECT_EXECUTION_VIEW" episodePolicy="STATIC_LIFETIME" self="GreetingRun"/>
    <requirement id="console-operations" provider="cartago.operation-history.v1" source="artifact:display.GUIConsole" operations="printMsg"/>
    <verify target="GreetingObserver.TwelveMessagesObserved" scope="workspace:*"/>
    <milestones kind="DOMAIN"/>
  </runtime>
</mapping>

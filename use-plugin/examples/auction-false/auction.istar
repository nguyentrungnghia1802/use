// Auction iStar system specification. Based on Desktop
// auction_istar_final_fixed.drawio, including Artifact Resources.
// Notation: explicit AND children and same-player Agent/Role participation.
// Capability Agent performs Tasks; Roles express the responsibilities it plays. Actor Auction is a context viewpoint, not a running agent.
// Deliberate current-policy delta from success-only diagram notes:
// P_bid_t2 completes an observed attempt, including only the exact .fail site
// accepted by XML. O_bid additionally requires actual Artifact acceptance.
// Agent/program source, mission commitments, action receipts and self identity
// are connected by XML, never inferred from names or console Winner messages.
istar AuctionGoals {
    agent Auction {
        goal O_root : Achieve
        goal O_start : Achieve > O_root
        goal O_bid : Achieve > O_root
        goal O_bid_attempt : Achieve > O_bid
        goal O_bid_accepted : Achieve > O_bid
            condition {[ self.currentWinner <> 'no_winner' ]}
        goal O_decide : Achieve > O_root
    }
    // Concrete agent type, with one runtime occurrence per actual player.
    // Role responsibilities delegate to this SAME player's capability goal.
    agent auction_capabilities {
        auction_capabilities participates-in Auctioneer
        auction_capabilities participates-in Participant
        goal C_start : Achieve
        task A_start_t1 > C_start
            pre {[ step.enabled ]}
            post {[ step.succeeded ]}
        task A_start_t2 > C_start
            pre {[ not self.running ]}
            post {[ self.running and self.task = service ]}
        goal C_decide : Achieve
        task A_decide_t2 > C_decide
            pre {[ self.running ]}
            post {[ not self.running ]}
        goal C_bid : Achieve
        task P_bid_t1 > C_bid
            pre {[ step.enabled ]}
            post {[ step.succeeded ]}
        task P_bid_t2 > C_bid
            pre {[ step.enabled and self.running ]}
            post {[ step.completed ]}
        resource A_artifact > needed-by A_start_t2 > needed-by A_decide_t2
        resource P_artifact > needed-by P_bid_t2
    }
    role Auctioneer {
        goal A_start : Achieve
        goal A_decide : Achieve
    }
    role Participant {
        goal P_bid : Achieve
    }
    depend Auctioneer.A_start -> goal D_capability_start -> auction_capabilities.C_start
    depend Auctioneer.A_decide -> goal D_capability_decide -> auction_capabilities.C_decide
    depend Participant.P_bid -> goal D_capability_bid -> auction_capabilities.C_bid
    depend Auction.O_start -> goal D_start -> Auctioneer.A_start
    depend Auction.O_decide -> goal D_decide -> Auctioneer.A_decide
    depend Auction.O_bid_attempt -> goal D_bid -> Participant.P_bid
}

// Behavioral observer contracts audit source-confirmed ordering/evidence.
// They are not CSL Entities, nor definitions of Goal satisfaction.
// Public confirmation times are not exact internal truth-change times.
/* @use-native-ocl 1
context AuctionMonitor
inv ConfirmedSchemeOrder:
    (self.bidEnabledConfirmedAt >= 0 implies
        self.startSatisfiedConfirmedAt >= 0 and
        self.startSatisfiedConfirmedAt <= self.bidEnabledConfirmedAt) and
    (self.bidSatisfiedConfirmedAt >= 0 implies
        self.bidEnabledConfirmedAt >= 0 and
        self.bidEnabledConfirmedAt <= self.bidSatisfiedConfirmedAt) and
    (self.decideEnabledConfirmedAt >= 0 implies
        self.bidSatisfiedConfirmedAt >= 0 and
        self.bidSatisfiedConfirmedAt <= self.decideEnabledConfirmedAt) and
    (self.decideSatisfiedConfirmedAt >= 0 implies
        self.decideEnabledConfirmedAt >= 0 and
        self.decideEnabledConfirmedAt <= self.decideSatisfiedConfirmedAt)

-- Keep latest Desktop EXISTS semantics: at least one committed participant
-- has both observed MOISE done evidence and a successful real bid, unless the
-- exact successful administrative override is observed. The override permits
-- scheme progress; it does not satisfy D_bid or count as an actual bid.
-- Role population is not mission commitment. Freeze bidCommittedBy at the first
-- observed bid satisfaction; keep exact same-run/same-scheme player identities.
context AuctionMonitor
inv ObservedBidEvidence:
    self.bidDoneBy->forAll(a |
        self.actualBidBy->includes(a)) and
    (self.bidSatisfiedObserved implies
        self.adminBidOverride or
        self.bidCommittedBy->exists(a |
            self.bidDoneBy->includes(a) and
            self.actualBidBy->includes(a)))
*/

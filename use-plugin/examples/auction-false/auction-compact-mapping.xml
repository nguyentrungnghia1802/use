    <map source="asl:src/agt/auction_capabilities.asl/plan:start[scheme(Sch)]/step:A_start_t2[5..6]" target="auction_capabilities.A_start_t2" self="Auction" variables="Id Sch S ArtId" schemeVariable="Sch" artifactVariable="ArtId" artifactClass="auction_env.AuctionArtifact" inputs="service:S:java.lang.String" actionReceipts="start"/>
    <map source="asl:src/agt/auction_capabilities.asl/plan:decide[scheme(Sch)]/step:A_decide_t2[2..3]" target="auction_capabilities.A_decide_t2" self="Auction" variables="Id Sch ArtId" schemeVariable="Sch" artifactVariable="ArtId" artifactClass="auction_env.AuctionArtifact" actionReceipts="stop"/>
    <map source="asl:src/agt/auction_capabilities.asl/plan:bid[scheme(Sch)]/step:P_bid_t1[0..3]" target="auction_capabilities.P_bid_t1" self="Auction" variables="Id Sch AId" schemeVariable="Sch" artifactVariable="AId" artifactClass="auction_env.AuctionArtifact" allowMissingArtifactAtEntry="true"/>
    <map source="asl:src/agt/auction_capabilities.asl/plan:bid[scheme(Sch)]/step:P_bid_t2[3..4]" target="auction_capabilities.P_bid_t2" self="Auction" variables="Id Sch AId" schemeVariable="Sch" artifactVariable="AId" artifactClass="auction_env.AuctionArtifact" actionReceipts="bid"/>
    <map source="artifact:auction_env.AuctionArtifact" target="auction_capabilities.AuctionArtifact"/>
    <map source="moise:auction/role:auctioneer" target="Auctioneer"/>
    <map source="moise:auction/role:participant" target="Participant"/>
  </istar>
  <runtime>
    <actorRuntime actor="Auction" activationPolicy="OBSERVED_SCHEME_COMMITMENT" episodePolicy="STATIC_LIFETIME" self="Auction"/>
    <actorRuntime actor="auction_capabilities" activationPolicy="AGENT_ENACTMENT" episodePolicy="RUN_SCHEME_PLAYER_INVOCATION" physicalActorView="true" self="auction_capabilities"/>
    <actorRuntime actor="Auctioneer" activationPolicy="EXPLICIT_ENACTMENT" episodePolicy="STATIC_LIFETIME" self="auctioneer"/>
    <actorRuntime actor="Participant" activationPolicy="EXPLICIT_ENACTMENT" episodePolicy="STATIC_LIFETIME" self="participant"/>
    <requirement id="cartago.artifact-field.v1" provider="cartago.artifact-field.v1"/>
    <dependencyPopulation target="D_bid" quantifier="ANY"/>
    <goalRealization target="A_start" source="C_start" sourceGoal="start" sourceRef="moise:auction/scheme:doAuction" scheme="doAuction" policy="SAME_SCOPE_PLAYER_REFINEMENT_VIEW/1.0" reason="Same source goal, scheme and physical player; preserve the authored refinement view"/>
    <goalRealization target="A_decide" source="C_decide" sourceGoal="decide" sourceRef="moise:auction/scheme:doAuction" scheme="doAuction" policy="SAME_SCOPE_PLAYER_REFINEMENT_VIEW/1.0" reason="Same source goal, scheme and physical player; preserve the authored refinement view"/>
    <goalRealization target="P_bid" source="C_bid" sourceGoal="bid" sourceRef="moise:auction/scheme:doAuction" scheme="doAuction" policy="SAME_SCOPE_PLAYER_REFINEMENT_VIEW/1.0" reason="Same source goal, scheme and physical player; preserve the authored refinement view"/>
    <verify target="Auction.O_root"/>
    <milestones kind="DOMAIN"/>
  </runtime>

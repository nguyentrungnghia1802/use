      <field name="now" type="Integer" origin="NPL_RELATIVE_NOW/1.0"/>
      <field name="startSatisfiedAt" type="Integer" origin="MOISE_FIRST_STATE_SEQUENCE/1.0:start:SATISFIED"/>
      <field name="bidEnabledAt" type="Integer" origin="MOISE_FIRST_STATE_SEQUENCE/1.0:bid:ENABLED"/>
      <field name="bidSatisfiedAt" type="Integer" origin="MOISE_FIRST_STATE_SEQUENCE/1.0:bid:SATISFIED"/>
      <field name="decideEnabledAt" type="Integer" origin="MOISE_FIRST_STATE_SEQUENCE/1.0:decide:ENABLED"/>
      <field name="decideSatisfiedAt" type="Integer" origin="MOISE_FIRST_STATE_SEQUENCE/1.0:decide:SATISFIED"/>
      <field name="adminBidOverride" type="Boolean" origin="MOISE_ADMIN_GOAL_SATISFIED/1.0:bid"/>
      <field name="bidCommittedBy" type="Set(String)" origin="MOISE_FIRST_STATE_COMMITTED_PLAYERS/1.0:bid:SATISFIED"/>
      <field name="bidDoneBy" type="Set(String)" origin="MOISE_DONE_PLAYERS/1.0:bid"/>
      <field name="actualBidBy" type="Set(String)" origin="JASON_SUCCESSFUL_ACTION_PLAYERS/1.0:P_bid_t2:bid"/>
    </view>
    <view id="view-obligation" name="AuctionObligation" category="CLASS" keyFields="runId schemeUid player activation" source="moise:auction/scheme:doAuction" population="NPL_GOAL_OBLIGATIONS/1.0">
      <field name="goal" type="String" origin="NPL_GOAL/1.0"/>
      <field name="activatedAt" type="Integer" origin="NPL_ACTIVATED_AT/1.0"/>
      <field name="deadlineAt" type="Integer" origin="NPL_DEADLINE_AT/1.0"/>
      <field name="endedAt" type="Integer" origin="NPL_ENDED_AT/1.0"/>
      <field name="unfulfilled" type="Boolean" origin="NPL_REPORTED_UNFULFILLED/1.0"/>
      <field name="monitor" type="AuctionMonitor" origin="NPL_SCHEME_VIEW_REFERENCE/1.0:view-monitor"/>
    </view>
  </observers>
</mapping>

        "sourceEOpposite": {
          "type": "string",
          "pattern": "^agentmetamodel::[A-Za-z_][A-Za-z0-9_]*#[A-Za-z_][A-Za-z0-9_]*$"
        },
        "target": {
          "oneOf": [
            {
              "$ref": "#/$defs/emittedAssociationTarget"
            },
            {
              "$ref": "#/$defs/aliasTarget"
            }
          ]
        },
        "navigation": {
          "oneOf": [
            {
              "$ref": "#/$defs/emittedNavigation"
            },
            {
              "$ref": "#/$defs/aliasNavigation"
            }
          ]
        },
        "runtimeLinkCommand": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "enum": [
            "CONTAINMENT_TO_COMPOSITION",
            "REFERENCE_TO_ASSOCIATION",
            "EOPPOSITE_PAIR_TO_SINGLE_ASSOCIATION",
            "EOPPOSITE_ALIAS_TO_CANONICAL_ASSOCIATION"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^R[0-9]{3}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sourceContainment": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "properties": {
                  "kind": {
                    "const": "USE_COMPOSITION"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "policy": {
                "const": "CONTAINMENT_TO_COMPOSITION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "policy": {
                "const": "EOPPOSITE_ALIAS_TO_CANONICAL_ASSOCIATION"
              }
            }
          },
          "then": {
            "required": [
              "sourceEOpposite"
            ],
            "properties": {
              "target": {
                "$ref": "#/$defs/aliasTarget"
              },
              "navigation": {
                "$ref": "#/$defs/aliasNavigation"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "policy": {
                "const": "EOPPOSITE_PAIR_TO_SINGLE_ASSOCIATION"
              }
            }
          },
          "then": {
            "required": [
              "sourceEOpposite"
            ],
            "properties": {
              "target": {
                "properties": {
                  "kind": {
                    "const": "USE_ASSOCIATION"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          }
        }
      ]

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jacamo:metamodel-mapping:v2:schema:2.2.0",
  "title": "JaCaMo V2 -> USE metamodel mapping (strict schema 2.2.0)",
  "type": "object",
  "required": [
    "schemaVersion",
    "mappingId",
    "status",
    "createdDate",
    "purpose",
    "architecture",
    "sourceMetamodel",
    "targetUSE",
    "policies",
    "enumMappings",
    "classMappings",
    "attributeMappings",
    "inheritanceMappings",
    "referenceMappings",
    "verificationProjections",
    "runtimeMaterialization",
    "externalProjectionRequirements",
    "reviewFlags",
    "statistics",
    "$schema",
    "contract",
    "orderProjection"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2.2.0"
    },
    "mappingId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "REVIEWED_CANDIDATE_V2",
        "FROZEN",
        "WORKING_BASELINE"
      ]
    },
    "createdDate": {
      "type": "string",
      "format": "date"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "architecture": {
      "$ref": "#/$defs/architecture"
    },
    "sourceMetamodel": {
      "$ref": "#/$defs/sourceMetamodel"
    },
    "targetUSE": {
      "$ref": "#/$defs/targetUSE"
    },
    "policies": {
      "$ref": "#/$defs/policies"
    },
    "enumMappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/enumMapping"
      }
    },
    "classMappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/classMapping"
      }
    },
    "attributeMappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attributeMapping"
      }
    },
    "inheritanceMappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inheritanceMapping"
      }
    },
    "referenceMappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/referenceMapping"
      }
    },
    "verificationProjections": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/projection"
      }
    },
    "runtimeMaterialization": {
      "$ref": "#/$defs/runtimeMaterialization"
    },
    "externalProjectionRequirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/externalProjectionRequirement"
      }
    },
    "reviewFlags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewFlag"
      }
    },
    "statistics": {
      "$ref": "#/$defs/statistics"
    },
    "$schema": {
      "const": "jacamo-use-mapping-v2.schema.json"
    },
    "contract": {
      "$ref": "#/$defs/contract"
    },
    "orderProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "scope",
        "membership",
        "rankBase",
        "entryIdentity",
        "navigation",
        "opposite",
        "unknownOrder",
        "runtime",
        "constraints",
        "sourceMetamodelUnchanged"
      ],
      "properties": {
        "kind": {
          "const": "TARGET_ONLY_INDEPENDENT_RANKS"
        },
        "version": {
          "const": "1.0.0"
        },
        "scope": {
          "const": "ALL_ORDERED_MANY_SOURCE_REFERENCES"
        },
        "membership": {
          "const": "CANONICAL_ASSOCIATION_ONCE"
        },
        "rankBase": {
          "const": 0
        },
        "entryIdentity": {
          "const": "SOURCE_FEATURE_OWNER_TARGET"
        },
        "navigation": {
          "const": "SORT_RANK_COLLECT_TARGET_SEQUENCE"
        },
        "opposite": {
          "const": "INDEPENDENT_AUTHORITATIVE_DIRECTIONS"
        },
        "unknownOrder": {
          "const": "REJECT_UNRESOLVED_NO_INFERENCE"
        },
        "runtime": {
          "const": "ORDER_ONLY_UPDATES_RANKS_AUTHORITATIVE_RESYNC"
        },
        "constraints": {
          "const": [
            "EXACT_MEMBERSHIP_BIJECTION",
            "UNIQUE_TARGET_PER_OWNER_FEATURE",
            "CONTIGUOUS_UNIQUE_RANKS",
            "TYPED_ENDPOINTS"
          ]
        },
        "sourceMetamodelUnchanged": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "dimension": {
      "enum": [
        "organisation",
        "agent",
        "environment"
      ]
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
    },
    "multiplicity": {
      "type": "object",
      "required": [
        "lower",
        "upper",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "lower": {
          "type": "integer",
          "minimum": 0
        },
        "upper": {
          "type": "integer",
          "minimum": -1
        },
        "text": {
          "type": "string",
          "pattern": "^(\\*|[0-9]+|[0-9]+\\.\\.(\\*|[0-9]+))$"
        }
      }
    },
    "associationEnd": {
      "type": "object",
      "required": [
        "class",
        "multiplicity",
        "role",
        "ordered"
      ],
      "additionalProperties": false,
      "properties": {
        "class": {
          "$ref": "#/$defs/identifier"
        },
        "multiplicity": {
          "type": "string",
          "pattern": "^(\\*|[0-9]+|[0-9]+\\.\\.(\\*|[0-9]+))$"
        },
        "role": {
          "$ref": "#/$defs/identifier"
        },
        "ordered": {
          "type": "boolean"
        }
      }
    },
    "architecture": {
      "type": "object",
      "required": [
        "verificationInput",
        "semanticBoundary",
        "outputs",
        "oclStage"
      ],
      "additionalProperties": false,
      "properties": {
        "verificationInput": {
          "type": "object",
          "required": [
            "kind",
            "entryPoint",
            "resolvedDependentSources",
            "directEcoreAsProjectInput"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "entryPoint": {
              "type": "string",
              "minLength": 1
            },
            "resolvedDependentSources": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "directEcoreAsProjectInput": {
              "type": "boolean"
            }
          }
        },
        "semanticBoundary": {
          "type": "object",
          "required": [
            "inputToMapper",
            "conformsTo",
            "rule"
          ],
          "additionalProperties": false,
          "properties": {
            "inputToMapper": {
              "type": "string",
              "minLength": 1
            },
            "conformsTo": {
              "type": "string",
              "minLength": 1
            },
            "rule": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "defaultFileName",
              "contains",
              "internalRoot"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "defaultFileName": {
                "type": "string",
                "minLength": 1
              },
              "contains": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "internalRoot": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "oclStage": {
          "type": "object",
          "required": [
            "mappingFileContainsOclConstraints",
            "policy"
          ],
          "additionalProperties": false,
          "properties": {
            "mappingFileContainsOclConstraints": {
              "type": "boolean"
            },
            "policy": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "sourceMetamodel": {
      "type": "object",
      "required": [
        "artifact",
        "packageName",
        "nsURI",
        "nsPrefix",
        "sha256",
        "artifactStatus",
        "expectedStatistics"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "packageName": {
          "const": "agentmetamodel"
        },
        "nsURI": {
          "type": "string",
          "minLength": 1
        },
        "nsPrefix": {
          "const": "agentmetamodel"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifactStatus": {
          "type": "string",
          "minLength": 1
        },
        "expectedStatistics": {
          "type": "object",
          "required": [
            "EEnums",
            "EClasses",
            "EAttributes",
            "EReferences",
            "EGeneralizations",
            "EOppositePairs",
            "RequiredEAttributes",
            "ExplicitDefaultEAttributes",
            "ContainmentEReferences",
            "ManyValuedEReferences"
          ],
          "additionalProperties": false,
          "properties": {
            "EEnums": {
              "type": "integer",
              "minimum": 0
            },
            "EClasses": {
              "type": "integer",
              "minimum": 0
            },
            "EAttributes": {
              "type": "integer",
              "minimum": 0
            },
            "EReferences": {
              "type": "integer",
              "minimum": 0
            },
            "EGeneralizations": {
              "type": "integer",
              "minimum": 0
            },
            "EOppositePairs": {
              "type": "integer",
              "minimum": 0
            },
            "RequiredEAttributes": {
              "type": "integer",
              "minimum": 0
            },
            "ExplicitDefaultEAttributes": {
              "type": "integer",
              "minimum": 0
            },
            "ContainmentEReferences": {
              "type": "integer",
              "minimum": 0
            },
            "ManyValuedEReferences": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "targetUSE": {
      "type": "object",
      "required": [
        "repository",
        "upstream",
        "manual",
        "textualModelExtension",
        "stateScriptExtension",
        "constructs",
        "inspectedRevision",
        "version",
        "sourceEvidence",
        "validationScope"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "upstream": {
          "type": "string",
          "minLength": 1
        },
        "manual": {
          "type": "string",
          "minLength": 1
        },
        "textualModelExtension": {
          "const": ".use"
        },
        "stateScriptExtension": {
          "const": ".cmd"
        },
        "constructs": {
          "type": "object",
          "required": [
            "model",
            "enum",
            "class",
            "attribute",
            "association",
            "composition",
            "operation",
            "systemState",
            "constraints"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "enum": {
              "type": "string",
              "minLength": 1
            },
            "class": {
              "type": "string",
              "minLength": 1
            },
            "attribute": {
              "type": "string",
              "minLength": 1
            },
            "association": {
              "type": "string",
              "minLength": 1
            },
            "composition": {
              "type": "string",
              "minLength": 1
            },
            "operation": {
              "type": "string",
              "minLength": 1
            },
            "systemState": {
              "type": "string",
              "minLength": 1
            },
            "constraints": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "inspectedRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sourceEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validationScope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "policies": {
      "type": "object",
      "required": [
        "datatypeMappings",
        "enumMapping",
        "classMapping",
        "attributeMapping",
        "attributeRequirednessPolicy",
        "explicitDefaultPolicy",
        "inheritanceMapping",
        "containmentReferenceMapping",
        "nonContainmentReferenceMapping",
        "identifierPolicy",
        "sourceExpressionPolicy",
        "enumValuePolicy",
        "constraintPolicy",
        "oppositePolicy",
        "navigationPolicy",
        "orderingPolicy",
        "evolutionPolicy"
      ],
      "additionalProperties": false,
      "properties": {
        "datatypeMappings": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": [
              "source",
              "target"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "enumMapping": {
          "type": "string",
          "minLength": 1
        },
        "classMapping": {
          "type": "string",
          "minLength": 1
        },
        "attributeMapping": {
          "type": "string",
          "minLength": 1
        },
        "attributeRequirednessPolicy": {
          "type": "string",
          "minLength": 1
        },
        "explicitDefaultPolicy": {
          "type": "string",
          "minLength": 1
        },
        "inheritanceMapping": {
          "type": "string",
          "minLength": 1
        },
        "sourceExpressionPolicy": {
          "type": "string",
          "minLength": 1
        },
        "enumValuePolicy": {
          "type": "string",
          "minLength": 1
        },
        "constraintPolicy": {
          "type": "string",
          "minLength": 1
        },
        "oppositePolicy": {
          "type": "string",
          "minLength": 1
        },
        "navigationPolicy": {
          "type": "string",
          "minLength": 1
        },
        "orderingPolicy": {
          "type": "string",
          "minLength": 1
        },
        "containmentReferenceMapping": {
          "type": "object",
          "required": [
            "target",
            "firstEnd",
            "firstEndMultiplicity",
            "secondEndMultiplicity",
            "forwardRole",
            "reverseRole",
            "reverseNavigationAuthoritative",
            "globalContainmentGuard"
          ],
          "additionalProperties": false,
          "properties": {
            "target": {
              "const": "composition"
            },
            "firstEnd": {
              "type": "string"
            },
            "firstEndMultiplicity": {
              "type": "string"
            },
            "secondEndMultiplicity": {
              "type": "string"
            },
            "forwardRole": {
              "type": "string"
            },
            "reverseRole": {
              "type": "string"
            },
            "reverseNavigationAuthoritative": {
              "type": "boolean"
            },
            "globalContainmentGuard": {
              "type": "string"
            }
          }
        },
        "nonContainmentReferenceMapping": {
          "type": "object",
          "required": [
            "withoutEOpposite",
            "withEOpposite",
            "forwardMultiplicity"
          ],
          "additionalProperties": false,
          "properties": {
            "withoutEOpposite": {
              "type": "string"
            },
            "withEOpposite": {
              "type": "string"
            },
            "forwardMultiplicity": {
              "type": "string"
            }
          }
        },
        "identifierPolicy": {
          "type": "object",
          "required": [
            "metamodelElements",
            "projectObjectIdentifiers",
            "generatedConcreteArtifactClass",
            "targetAttributeEscapes",
            "targetAssociationRoleEscapes"
          ],
          "additionalProperties": false,
          "properties": {
            "metamodelElements": {
              "type": "string"
            },
            "projectObjectIdentifiers": {
              "type": "string"
            },
            "generatedConcreteArtifactClass": {
              "type": "string"
            },
            "targetAttributeEscapes": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
              }
            },
            "targetAssociationRoleEscapes": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
              }
            }
          }
        },
        "evolutionPolicy": {
          "type": "object",
          "required": [
            "fingerprintMismatch",
            "stableSourceKey",
            "unchangedElement",
            "addedEClassEnumOrFeature",
            "changedTypeBoundsContainmentOppositeOrSupertype",
            "removedOrRenamedElement",
            "versioning"
          ],
          "additionalProperties": false,
          "properties": {
            "fingerprintMismatch": {
              "type": "string",
              "minLength": 1
            },
            "stableSourceKey": {
              "type": "string",
              "minLength": 1
            },
            "unchangedElement": {
              "type": "string",
              "minLength": 1
            },
            "addedEClassEnumOrFeature": {
              "type": "string",
              "minLength": 1
            },
            "changedTypeBoundsContainmentOppositeOrSupertype": {
              "type": "string",
              "minLength": 1
            },
            "removedOrRenamedElement": {
              "type": "string",
              "minLength": 1
            },
            "versioning": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "enumLiteral": {
      "type": "object",
      "required": [
        "name",
        "literal",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "literal": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "integer"
        }
      }
    },
    "enumMapping": {
      "type": "object",
      "required": [
        "source",
        "sourceKind",
        "dimension",
        "sourceLiterals",
        "target",
        "valuePolicy",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^agentmetamodel::[A-Za-z_][A-Za-z0-9_]*$"
        },
        "sourceKind": {
          "const": "EEnum"
        },
        "dimension": {
          "$ref": "#/$defs/dimension"
        },
        "sourceLiterals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/enumLiteral"
          }
        },
        "target": {
          "type": "object",
          "required": [
            "kind",
            "internalConcept",
            "name",
            "literals"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "USE_ENUM"
            },
            "internalConcept": {
              "const": "EnumType"
            },
            "name": {
              "$ref": "#/$defs/identifier"
            },
            "literals": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        },
        "valuePolicy": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "pattern": "^E[0-9]{3}$"
        }
      }
    },
    "classMapping": {
      "type": "object",
      "required": [
        "source",
        "sourceKind",
        "dimension",
        "sourceAbstract",
        "target",
        "policy",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^agentmetamodel::[A-Za-z_][A-Za-z0-9_]*$"
        },
        "sourceKind": {
          "const": "EClass"
        },
        "dimension": {
          "$ref": "#/$defs/dimension"
        },
        "sourceAbstract": {
          "type": "boolean"
        },
        "target": {
          "type": "object",
          "required": [
            "kind",
            "internalConcept",
            "name",
            "abstract"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "USE_CLASS"
            },
            "internalConcept": {
              "const": "MClass"
            },
            "name": {
              "$ref": "#/$defs/identifier"
            },
            "abstract": {
              "type": "boolean"
            }
          }
        },
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "pattern": "^C[0-9]{3}$"
        }
      }
    },
    "attributeMapping": {
      "type": "object",
      "required": [
        "source",
        "sourceKind",
        "dimension",
        "sourceOwner",
        "sourceName",
        "sourceType",
        "sourceMultiplicity",
        "sourceRequired",
        "target",
        "valuePolicy",
        "absencePolicy",
        "targetFidelity",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^agentmetamodel::[A-Za-z_][A-Za-z0-9_]*#[A-Za-z_][A-Za-z0-9_]*$"
        },
        "sourceKind": {
          "const": "EAttribute"
        },
        "dimension": {
          "$ref": "#/$defs/dimension"
        },
        "sourceOwner": {
          "$ref": "#/$defs/identifier"
        },
        "sourceName": {
          "$ref": "#/$defs/identifier"
        },
        "sourceType": {
          "type": "string",
          "pattern": "^(EString|EInt|EBoolean|EEnum:[A-Za-z_][A-Za-z0-9_]*)$"
        },
        "sourceMultiplicity": {
          "$ref": "#/$defs/multiplicity"
        },
        "sourceRequired": {
          "type": "boolean"
        },
        "target": {
          "type": "object",
          "required": [
            "kind",
            "internalConcept",
            "owner",
            "name",
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "USE_ATTRIBUTE"
            },
            "internalConcept": {
              "const": "MAttribute"
            },
            "owner": {
              "$ref": "#/$defs/identifier"
            },
            "name": {
              "$ref": "#/$defs/identifier"
            },
            "type": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        "valuePolicy": {
          "type": "string",
          "minLength": 1
        },
        "absencePolicy": {
          "enum": [
            "MATERIALIZE_EXPLICIT_ECORE_DEFAULT_WHEN_SOURCE_UNSET",
            "REQUIRE_RESOLVED_SOURCE_VALUE",
            "LEAVE_UNDEFINED_IF_SOURCE_UNSET"
          ]
        },
        "targetFidelity": {
          "enum": [
            "TYPE_EXACT_REQUIREDNESS_GUARDED_AT_MATERIALIZATION",
            "TYPE_EXACT_OPTIONAL_VALUE"
          ]
        },
        "id": {
          "type": "string",

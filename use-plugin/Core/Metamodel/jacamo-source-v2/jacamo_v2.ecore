    <eLiterals name="CHOICE" value="2" literal="choice"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="LinkType">
    <eLiterals name="AUTHORITY" value="0" literal="authority"/>
    <eLiterals name="COMMUNICATION" value="1" literal="communication"/>

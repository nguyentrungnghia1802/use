<?xml version='1.0' encoding='UTF-8'?>
<ecore:EPackage xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmi:version="2.0" name="agentmetamodel" nsURI="http://www.example.org/agentmetamodel" nsPrefix="agentmetamodel">
  <eClassifiers xsi:type="ecore:EEnum" name="NormType">

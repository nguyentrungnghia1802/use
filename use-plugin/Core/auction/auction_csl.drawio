<mxfile host="Electron" compressed="false" cslVersion="v4.0" cslSource="// SINGLE_AGENT_CONTEXT: each auction_capabilities instance represents one physical Agent.&#10;// Its possible enacts relations to auctioneer/participant are explicit mapping correspondences;&#10;// an actual enactment requires that same Agent&#x27;s observed Plays link (not context ownership).&#10;// Auction CSL system specification. Project .jcm is the runtime input;&#10;// this hand-authored model and mapping XML are system specifications.&#10;// Authoritative Core/auction/auction_csl.drawio: capability is a singleton-agent&#10;// OrgCtx, with enacts relations and no Role inheritance. Atom maps to String.&#10;// Beliefs are optional mental state, never authoritative Artifact/world values.&#10;// Typed belief scalars remain undefined without an unambiguous qualified binding.&#10;// @use-native-ocl 1 is an explicit USE plugin annotation. The original CSL parser&#10;// parses the structure/invariants; the plugin compiles this native contract block.&#10;csl v4.0 AuctionState {&#10;    orgContext AuctionOrg {&#10;        orgContext auctionGroup {&#10;            role auctioneer;&#10;            role participant;&#10;            // Model scope, not physical CArtAgO ownership or a disposal cascade.&#10;            entity Auction {&#10;                attribute id : String required;&#10;                attribute running : Boolean required mutable default false;&#10;                attribute task : String required mutable default &#x27;no_task&#x27;;&#10;                // Retain the source Double.MAX_VALUE; never invent a sentinel.&#10;                attribute best_bid : Real required mutable;&#10;                // Preserve the visible diagram&#x27;s authored default literal.&#10;                // Actual source Atom observations (including no_winner) overwrite it.&#10;                attribute winner : String required mutable default &#x27;defaul&#x27;;&#10;                // Source field, not an observable property. Requires explicit access.&#10;                attribute currentWinner : String required mutable default &#x27;no_winner&#x27;;&#10;            }&#10;        }&#10;    }&#10;&#10;    // One context instance represents exactly one physical Jason agent.&#10;    // It is not an adopted MOISE role and does not inherit from either role.&#10;    orgContext auction_capabilities {&#10;        attribute name : String required;&#10;        attribute beliefBase : String optional mutable;&#10;        attribute belief_joinedWsp : String optional mutable;&#10;        attribute belief_focusing : String optional mutable;&#10;        attribute belief_goalArgument : String optional mutable;&#10;        attribute belief_play : String optional mutable;&#10;        attribute belief_running : String optional mutable;&#10;        attribute belief_task : String optional mutable;&#10;        attribute belief_best_bid : Real optional mutable;&#10;        attribute belief_winner : String optional mutable;&#10;    }&#10;&#10;    // Source role-population constraints, distinct from declaration containment.&#10;    // Operational invariant: XML activates this rule once a qualified source roster&#10;    // and complete matching native Role population establish readiness. Activation&#10;    // stays true for this group incarnation, so later role loss still violates it.&#10;    context auctionGroup inv AuctioneerPopulation:&#10;        self.auctioneer-&gt;size() = 1;&#10;    context auctionGroup inv ParticipantPopulation:&#10;        self.participant-&gt;size() &lt;= 300;&#10;}&#10;&#10;/* @use-native-ocl 1&#10;context Auction::start(service : String)&#10;pre Idle:&#10;    not self.running&#10;post Opened:&#10;    self.running and self.task = service&#10;&#10;context Auction::bid(amount : Real)&#10;pre RunningForBid:&#10;    self.running&#10;&#10;context Auction::stop()&#10;pre RunningForStop:&#10;    self.running&#10;post Closed:&#10;    not self.running&#10;*/&#10;" semanticAudit="The CSL capability viewpoint is represented by a singleton-player OrgCtx. No Role inheritance. Auction belongs to auctionGroup.entities. Atom is projected as String; optional typed beliefs require unambiguous qualified observations and otherwise remain undefined." beliefViewUpdate="Optional scalar belief_best_bid is Real; Atom maps to String. Multiple qualified values are not collapsed. No belief observer is requested by this example." pages="2" sourceAuthority="VISIBLE_CORE_DIAGRAM_USER_CONFIRMED_2026_11_05">

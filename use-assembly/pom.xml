<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.tzi.use</groupId>
        <artifactId>use</artifactId>
        <version>7.5.0</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <packaging>pom</packaging>
    <artifactId>use-assembly</artifactId>

    <dependencies>
        <dependency><groupId>org.tzi.use</groupId><artifactId>use-plugin</artifactId><version>1.0.1</version><type>zip</type><classifier>release</classifier><scope>provided</scope><exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
        <dependency>
            <groupId>org.tzi.use</groupId>
            <artifactId>use-gui</artifactId>
            <version>7.5.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin><artifactId>maven-dependency-plugin</artifactId><version>3.8.1</version><executions><execution>
                <id>stage-jacamo-plugin-distribution</id><phase>prepare-package</phase><goals><goal>unpack</goal></goals>
                <configuration><artifactItems><artifactItem><groupId>org.tzi.use</groupId><artifactId>use-plugin</artifactId><version>1.0.1</version>
                    <type>zip</type><classifier>release</classifier><outputDirectory>${project.build.directory}/plugin-distribution</outputDirectory><overWrite>true</overWrite>
                </artifactItem></artifactItems></configuration>
            </execution></executions></plugin>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <descriptors>
                        <descriptor>src/assembly/assembly.xml</descriptor>
                    </descriptors>
                    <finalName>use-${project.version}</finalName>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- One stable runnable installation; replace it only after extraction succeeds. -->
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>publish-latest-runnable-install</id>
                        <phase>package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <delete dir="${project.build.directory}/new-staging"/>
                                <mkdir dir="${project.build.directory}/new-staging"/>
                                <unzip src="${project.build.directory}/use-${project.version}-use-bin.zip"
                                       dest="${project.build.directory}/new-staging">
                                    <mapper type="glob" from="use-${project.version}/*" to="*"/>
                                </unzip>
                                <available file="${project.build.directory}/new-staging/bin/start_use.bat"
                                           property="latest.launcher.present"/>
                                <fail unless="latest.launcher.present">Latest installation has no launcher; previous installation retained.</fail>
                                <move todir="${project.build.directory}/new-staging/work">
                                    <fileset dir="${project.build.directory}/new/work" erroronmissingdir="false"/>
                                </move>
                                <delete dir="${project.build.directory}/new"/>
                                <move file="${project.build.directory}/new-staging" tofile="${project.build.directory}/new"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
